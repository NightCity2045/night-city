<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Fixers.NCFixerWindow"
                      SetSize="600 660"
                      MinSize="480 460">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Name="DescriptionLabel" FontColorOverride="#AAAAAA" />
        <RichTextLabel Name="GreetingLabel" />
        <Label Name="ReputationLabel" FontColorOverride="#FFB21F" />
        <PanelContainer StyleClasses="LowDivider" />
        <BoxContainer Name="ActivePanel" Orientation="Vertical" SeparationOverride="4" Visible="False">
            <Label Text="{Loc 'nc-fixer-active-title'}" StyleClasses="LabelHeading" />
            <Label Name="ActiveNameLabel" />
            <Label Name="ActiveStatusLabel" FontColorOverride="#9FE3A5" />
            <Label Name="ActiveObjectiveLabel" />
            <Label Name="ActiveDropLabel" />
            <Label Name="ActiveTargetLabel" FontColorOverride="#E3A59F" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="AbandonButton" Text="{Loc 'nc-fixer-abandon'}" />
                <Button Name="CollectButton" Text="{Loc 'nc-fixer-collect'}" />
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" />
        </BoxContainer>
        <Label Text="{Loc 'nc-fixer-offers-title'}" StyleClasses="LabelHeading" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="OffersContainer" Orientation="Vertical" SeparationOverride="8" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
