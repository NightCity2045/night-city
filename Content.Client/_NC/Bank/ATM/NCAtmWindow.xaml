<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Bank.ATM.NCAtmWindow"
                      Title="{Loc 'nc-atm-window-title'}"
                      SetSize="460 560">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="10">
        <Label Name="StatusLabel" Align="Center" />

        <BoxContainer Name="LoginContainer" Orientation="Vertical" SeparationOverride="5">
            <LineEdit Name="AccountNumberEdit" PlaceHolder="{Loc 'nc-atm-account-placeholder'}" />
            <LineEdit Name="PinEdit" PlaceHolder="{Loc 'nc-atm-pin-placeholder'}" />
            <Button Name="LoginButton" Text="{Loc 'nc-atm-login'}" />
        </BoxContainer>

        <BoxContainer Name="AccountContainer" Orientation="Vertical" SeparationOverride="5" Visible="False">
            <Button Name="LogoutButton" Text="{Loc 'nc-atm-logout'}" />
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-atm-balance-label'}" StyleClasses="LabelKeyText" />
                <Label Name="BalanceLabel" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-atm-tax-label'}" StyleClasses="LabelKeyText" />
                <Label Name="TaxLabel" FontColorOverride="#AAAAAA" />
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <LineEdit Name="WithdrawEdit" PlaceHolder="{Loc 'nc-atm-amount-placeholder'}" MinSize="100 0" />
                <Button Name="WithdrawButton" Text="{Loc 'nc-atm-withdraw'}" HorizontalExpand="True" />
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-atm-cash-label'}" StyleClasses="LabelKeyText" />
                <Label Name="DepositLabel" />
            </BoxContainer>
            <Button Name="DepositButton" Text="{Loc 'nc-atm-deposit'}" />
            <PanelContainer StyleClasses="LowDivider" />
            <Label Text="{Loc 'nc-atm-fines-title'}" StyleClasses="LabelHeading" />
            <Label Name="NoFinesLabel" Text="{Loc 'nc-atm-fines-none'}" FontColorOverride="DarkGray" Align="Center" />
            <ItemList Name="FinesList" MinHeight="120" VerticalExpand="True" />
            <Button Name="PayFineButton" Text="{Loc 'nc-atm-fine-pay'}" Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
