<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Bank.Budget.NCOrganizationBudgetConsoleWindow"
                      Title="{Loc 'nc-budget-window-title'}"
                      SetSize="560 620">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Name="OrganizationLabel" StyleClasses="LabelHeading" Align="Center" />

        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'nc-budget-balance-label'}" StyleClasses="LabelKeyText" />
            <Label Name="BalanceLabel" FontColorOverride="#63D17C" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'nc-budget-inserted-label'}" StyleClasses="LabelKeyText" />
            <Label Name="InsertedCashLabel" />
        </BoxContainer>
        <Label Name="ReadOnlyLabel"
               Text="{Loc 'nc-budget-read-only'}"
               FontColorOverride="#E6A65D"
               Align="Center" />

        <PanelContainer StyleClasses="LowDivider" />
        <LineEdit Name="ReasonEdit" PlaceHolder="{Loc 'nc-budget-reason-placeholder'}" />
        <Button Name="DepositButton" Text="{Loc 'nc-budget-deposit'}" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="5">
            <LineEdit Name="WithdrawAmountEdit"
                      PlaceHolder="{Loc 'nc-budget-amount-placeholder'}"
                      MinSize="130 0" />
            <Button Name="WithdrawButton"
                    Text="{Loc 'nc-budget-withdraw'}"
                    HorizontalExpand="True" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-budget-history-title'}" StyleClasses="LabelHeading" />
        <Label Name="NoHistoryLabel"
               Text="{Loc 'nc-budget-history-empty'}"
               FontColorOverride="DarkGray"
               Align="Center" />
        <ItemList Name="HistoryList" VerticalExpand="True" MinHeight="290" />
    </BoxContainer>
</controls:FancyWindow>
