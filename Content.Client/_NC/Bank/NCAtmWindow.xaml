<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Bank.NCAtmWindow"
                      Title="{Loc 'nc-bank-atm-title'}"
                      SetSize="420 330">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Name="UnavailableLabel" Text="{Loc 'nc-bank-no-account'}" Align="Center" Visible="False" />
        <BoxContainer Name="AccountContainer" Orientation="Vertical" SeparationOverride="6">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-bank-account-label'}" StyleClasses="LabelKeyText" />
                <Label Name="NumberLabel" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-bank-balance-label'}" StyleClasses="LabelKeyText" />
                <Label Name="BalanceLabel" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-bank-fee-label'}" StyleClasses="LabelKeyText" />
                <Label Name="FeeLabel" FontColorOverride="#AAAAAA" />
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'nc-bank-cash-label'}" StyleClasses="LabelKeyText" />
                <Label Name="CashLabel" />
            </BoxContainer>
            <Label Text="{Loc 'nc-bank-cash-hint'}" FontColorOverride="#888888" />
            <Button Name="DepositButton" Text="{Loc 'nc-bank-deposit'}" />
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                <LineEdit Name="WithdrawEdit" PlaceHolder="{Loc 'nc-bank-amount-placeholder'}" HorizontalExpand="True" />
                <Button Name="WithdrawButton" Text="{Loc 'nc-bank-withdraw'}" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
