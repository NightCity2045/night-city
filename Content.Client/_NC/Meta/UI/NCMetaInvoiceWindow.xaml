<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.Meta.UI.NCMetaInvoiceWindow"
    Title="{Loc 'nc-meta-invoice-title'}" MinWidth="500" SetWidth="560" SetHeight="300" Resizable="False">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
        <Label Text="{Loc 'nc-meta-invoice-native'}" />
        <Label Name="Payee" ClipText="True" />
        <Label Name="Amount" />
        <Label Name="Invoice" ClipText="True" />
        <Label Name="Digest" ClipText="True" />
        <Label Name="Expiry" />
        <Label Name="Notice" ClipText="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="Decline" Text="{Loc 'nc-meta-invoice-decline'}" HorizontalExpand="True" />
            <Button Name="Pay" Text="{Loc 'nc-meta-invoice-pay'}" HorizontalExpand="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
