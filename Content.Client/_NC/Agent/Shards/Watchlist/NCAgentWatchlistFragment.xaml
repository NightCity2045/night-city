<watchlist:NCAgentWatchlistFragment xmlns="https://spacestation14.io"
                                    xmlns:watchlist="clr-namespace:Content.Client._NC.Agent.Shards.Watchlist"
                                    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                                    Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
    <PanelContainer HorizontalExpand="True" Margin="0 0 0 6">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#271016" BorderColor="#FF5C7C" BorderThickness="1 1 1 2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="10 7">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Label Text="WATCHLIST // NCPD QUERY" FontColorOverride="#FF91A6" HorizontalExpand="True" />
                <Label Name="RecordCount" Text="0 RECORDS // 0 WARRANTS" FontColorOverride="#A85A69" />
            </BoxContainer>
            <Label Name="QueryStatus" Text="AUTHORIZED READ-ONLY CHANNEL" FontColorOverride="#FFD66B" />
        </BoxContainer>
    </PanelContainer>

    <LineEdit Name="SearchInput" PlaceHolder="search name, status, job, warrant or reason" HorizontalExpand="True" Margin="0 0 0 5" />
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 5">
        <Button Name="AllFilterButton" Text="ALL" HorizontalExpand="True" Margin="1" />
        <Button Name="PriorityFilterButton" Text="PRIORITY" HorizontalExpand="True" Margin="1" />
        <Button Name="WarrantsFilterButton" Text="WARRANTS" HorizontalExpand="True" Margin="1" />
    </BoxContainer>
    <PanelContainer Name="DetailPanel" Visible="False" HorizontalExpand="True" Margin="0 0 0 5">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#201219" BorderColor="#FFD66B" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Name="DetailContainer" Orientation="Vertical" HorizontalExpand="True" Margin="10 7" />
    </PanelContainer>
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Name="RecordContainer" Orientation="Vertical" HorizontalExpand="True" />
    </ScrollContainer>
</watchlist:NCAgentWatchlistFragment>
