<agent:NCAgentMissionsControl xmlns="https://spacestation14.io"
    xmlns:agent="clr-namespace:Content.Client._NC.Agent"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
    <Button Name="RefreshButton" Text="{Loc 'nc-agent-missions-refresh'}" />
    <RichTextLabel Name="NoticeLabel" Margin="0 6" />
    <ItemList Name="MissionList" MinHeight="125" VerticalExpand="True" />
    <ScrollContainer MinHeight="150" VerticalExpand="True" Margin="0 6">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <RichTextLabel Name="DetailsLabel" />
            <Label Name="TimerLabel" Margin="0 6" />
            <RichTextLabel Name="WarningLabel" Visible="False" />
            <RichTextLabel Name="AvailabilityLabel" />
        </BoxContainer>
    </ScrollContainer>
    <Button Name="StartButton" Text="{Loc 'nc-agent-missions-start'}" Disabled="True" />
    <controls:ConfirmButton Name="FinishButton" Text="{Loc 'nc-agent-missions-cancel'}"
        ConfirmationText="{Loc 'nc-mission-console-finish-confirm'}" Visible="False" Margin="0 4 0 0" />
</agent:NCAgentMissionsControl>
