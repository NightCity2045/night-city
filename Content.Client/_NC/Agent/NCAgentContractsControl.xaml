<agent:NCAgentContractsControl xmlns="https://spacestation14.io" xmlns:agent="clr-namespace:Content.Client._NC.Agent"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <Button Name="HistoryButton" Text="{Loc 'nc-contract-history'}" HorizontalExpand="True" />
        <Button Name="BoardButton" Text="{Loc 'nc-contract-board'}" HorizontalExpand="True" />
    </BoxContainer>
    <BoxContainer Orientation="Horizontal" Margin="0 4">
        <Button Name="RefreshButton" Text="{Loc 'nc-agent-missions-refresh'}" HorizontalExpand="True" />
        <Button Name="NextButton" Text="{Loc 'nc-contract-next'}" Disabled="True" />
    </BoxContainer>
    <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <RichTextLabel Name="NoticeLabel" Margin="0 6" />
            <Label Name="EmptyLabel" Text="{Loc 'nc-contract-empty'}" FontColorOverride="#6C918E" Visible="False" />
            <BoxContainer Name="ContractList" Orientation="Vertical" HorizontalExpand="True" />
            <PanelContainer Margin="0 8">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#071015" BorderColor="#24E0D0" BorderThickness="1 0 0 0" />
                </PanelContainer.PanelOverride>
                <RichTextLabel Name="DetailsLabel" Margin="10 8" />
            </PanelContainer>
            <Button Name="NewButton" Text="{Loc 'nc-contract-new'}" Margin="0 6" />
            <BoxContainer Name="Editor" Orientation="Vertical" Visible="False" SeparationOverride="4">
                <LineEdit Name="TitleEdit" PlaceHolder="{Loc 'nc-contract-title-placeholder'}" />
                <LineEdit Name="TermsEdit" PlaceHolder="{Loc 'nc-contract-terms-placeholder'}" />
                <LineEdit Name="RewardEdit" PlaceHolder="{Loc 'nc-contract-reward-placeholder'}" />
                <RichTextLabel Text="{Loc 'nc-contract-deadline-placeholder'}" />
                <LineEdit Name="DeadlineEdit" Text="0" />
                <Button Name="PublishButton" Text="{Loc 'nc-contract-publish'}" />
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
    <RichTextLabel Name="SelectedTitle" Margin="0 6 0 0" />
    <RichTextLabel Name="ActionHint" Margin="0 6" />
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <Button Name="AcceptButton" Text="{Loc 'nc-contract-accept'}" Visible="False" />
        <Button Name="ReadyButton" Text="{Loc 'nc-contract-ready'}" Visible="False" />
        <controls:ConfirmButton Name="CompleteButton" Text="{Loc 'nc-contract-complete'}"
            ConfirmationText="{Loc 'nc-contract-confirm'}" Visible="False" />
        <controls:ConfirmButton Name="CancelButton" Text="{Loc 'nc-contract-cancel'}"
            ConfirmationText="{Loc 'nc-contract-confirm'}" Visible="False" />
        <controls:ConfirmButton Name="WithdrawButton" Text="{Loc 'nc-contract-withdraw'}"
            ConfirmationText="{Loc 'nc-contract-confirm'}" Visible="False" />
    </BoxContainer>
</agent:NCAgentContractsControl>
