<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Cyberware.AutoImplanter.NCAutoImplanterWindow"
                      Title="{Loc 'nc-auto-implanter-title'}"
                      SetSize="480 640"
                      MinSize="380 360">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Text="{Loc 'nc-auto-implanter-hint'}" FontColorOverride="#888888" />
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'nc-auto-implanter-search'}" HorizontalExpand="True" />
        <PanelContainer StyleClasses="LowDivider" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="EntriesContainer" Orientation="Vertical" SeparationOverride="4" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
