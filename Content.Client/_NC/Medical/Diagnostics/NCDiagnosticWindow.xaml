<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Diagnostics.NCDiagnosticWindow"
                      Title="{Loc 'nc-medical-diagnostics-title'}"
                      SetSize="900 660">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
            <Label Name="TierLabel" StyleClasses="LabelHeading" HorizontalExpand="True" />
            <Label Name="RevisionLabel" FontColorOverride="#8A9BA8" />
        </BoxContainer>
        <Label Name="ObservationLabel" FontColorOverride="#8A9BA8" />
        <Label Name="FailureLabel" FontColorOverride="#FF6B6B" Visible="False" />
        <PanelContainer StyleClasses="LowDivider" />

        <TabContainer Name="Tabs" HorizontalExpand="True" VerticalExpand="True">
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="OverviewContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="RegionsContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="WoundsContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="OrgansContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="CyberwareContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Name="DrugsContainer"
                              Margin="8"
                              Orientation="Vertical"
                              SeparationOverride="5" />
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
