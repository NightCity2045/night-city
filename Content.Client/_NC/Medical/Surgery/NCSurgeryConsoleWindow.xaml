<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Surgery.NCSurgeryConsoleWindow"
                      Title="{Loc 'nc-medical-surgery-console-title'}"
                      SetSize="760 560">
    <BoxContainer Margin="12" Orientation="Vertical" SeparationOverride="8">
        <Label Text="{Loc 'nc-medical-surgery-console-private'}"
               FontColorOverride="#E6C15D" />
        <GridContainer Columns="2" HSeparationOverride="14" VSeparationOverride="5">
            <Label Text="{Loc 'nc-medical-surgery-console-patient'}" StyleClasses="LabelKeyText" />
            <Label Name="PatientLabel" />
            <Label Text="{Loc 'nc-medical-surgery-console-facility'}" StyleClasses="LabelKeyText" />
            <Label Name="FacilityLabel" />
            <Label Text="{Loc 'nc-medical-surgery-console-zone'}" StyleClasses="LabelKeyText" />
            <Label Name="ZoneLabel" />
            <Label Text="{Loc 'nc-medical-surgery-console-access'}" StyleClasses="LabelKeyText" />
            <Label Name="AccessLabel" />
            <Label Text="{Loc 'nc-medical-surgery-console-graft'}" StyleClasses="LabelKeyText" />
            <Label Name="GraftLabel" />
            <Label Text="{Loc 'nc-medical-surgery-console-active'}" StyleClasses="LabelKeyText" />
            <Label Name="ActiveLabel" />
        </GridContainer>

        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-medical-surgery-console-procedures'}" StyleClasses="LabelHeading" />
        <ItemList Name="ProcedureList" SelectMode="Single" VerticalExpand="True" MinHeight="300" />
        <Label Name="NoticeLabel"
               Visible="False"
               Align="Center"
               FontColorOverride="#E6C15D" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="RefreshButton"
                    Text="{Loc 'nc-medical-surgery-console-refresh'}"
                    HorizontalExpand="True" />
            <Button Name="ClearButton"
                    Text="{Loc 'nc-medical-surgery-console-clear'}"
                    HorizontalExpand="True" />
            <Button Name="SelectButton"
                    Text="{Loc 'nc-medical-surgery-console-bind'}"
                    HorizontalExpand="True"
                    Disabled="True" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
