<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Surgery.NCSurgeryConsoleWindow"
                      Title="{Loc 'nc-medical-surgery-console-title'}"
                      SetSize="1080 700"
                      MinSize="900 600">
    <BoxContainer Margin="12" Orientation="Vertical" SeparationOverride="10">
        <PanelContainer StyleClasses="AngleRect">
            <BoxContainer Margin="10 7" Orientation="Vertical" SeparationOverride="5">
                <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                    <Label Name="PatientLabel" StyleClasses="LabelHeadingBigger" HorizontalExpand="True" />
                    <Label Name="ConditionLabel" Align="Right" />
                </BoxContainer>
                <GridContainer Columns="8" HSeparationOverride="8" VSeparationOverride="3">
                    <Label Text="{Loc 'nc-medical-surgery-console-perfusion'}" StyleClasses="LabelKeyText" />
                    <Label Name="PerfusionLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-oxygen'}" StyleClasses="LabelKeyText" />
                    <Label Name="OxygenLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-shock'}" StyleClasses="LabelKeyText" />
                    <Label Name="ShockLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-pain'}" StyleClasses="LabelKeyText" />
                    <Label Name="PainLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-analgesia'}" StyleClasses="LabelKeyText" />
                    <Label Name="AnalgesiaLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-sedation'}" StyleClasses="LabelKeyText" />
                    <Label Name="SedationLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-anesthesia'}" StyleClasses="LabelKeyText" />
                    <Label Name="AnesthesiaLabel" />
                    <Label Text="{Loc 'nc-medical-surgery-console-facility'}" StyleClasses="LabelKeyText" />
                    <Label Name="FacilityLabel" />
                </GridContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="10" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="7" SetWidth="260">
                <Label Text="{Loc 'nc-medical-surgery-console-stage-anatomy'}" StyleClasses="LabelHeading" />
                <PanelContainer StyleClasses="AngleRect">
                    <BoxContainer Name="DollHost" Margin="8" HorizontalAlignment="Center" />
                </PanelContainer>
                <Label Name="ZoneLabel" Align="Center" />
                <Label Text="{Loc 'nc-medical-surgery-console-stage-procedure'}" StyleClasses="LabelHeading" />
                <ItemList Name="ProcedureList" SelectMode="Single" VerticalExpand="True" MinHeight="190" />
                <Button Name="SelectButton"
                        Text="{Loc 'nc-medical-surgery-console-bind'}"
                        Disabled="True" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" SetWidth="2" />

            <BoxContainer Orientation="Vertical" SeparationOverride="7" HorizontalExpand="True">
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Label Text="{Loc 'nc-medical-surgery-console-stage-steps'}"
                           StyleClasses="LabelHeading"
                           HorizontalExpand="True" />
                    <Label Name="AccessLabel" Align="Right" />
                </BoxContainer>
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="StepList" Orientation="Vertical" SeparationOverride="6" />
                </ScrollContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" SetWidth="2" />

            <BoxContainer Orientation="Vertical" SeparationOverride="8" SetWidth="310">
                <Label Text="{Loc 'nc-medical-surgery-console-stage-action'}" StyleClasses="LabelHeading" />
                <Label Name="CurrentStepLabel" StyleClasses="LabelHeadingBigger" />
                <Label Name="StepMetaLabel" />
                <PanelContainer StyleClasses="AngleRect">
                    <BoxContainer Margin="8" Orientation="Vertical" SeparationOverride="5">
                        <Label Text="{Loc 'nc-medical-surgery-console-tools'}" StyleClasses="LabelKeyText" />
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <EntityPrototypeView Name="RequiredToolView"
                                                 Visible="False"
                                                 SetSize="64 64"
                                                 Scale="2 2"
                                                 Stretch="Fill"
                                                 VerticalAlignment="Center" />
                            <BoxContainer Name="ToolList"
                                          Orientation="Vertical"
                                          SeparationOverride="3"
                                          VerticalAlignment="Center"
                                          HorizontalExpand="True" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
                <Label Name="HeldToolLabel" />
                <ProgressBar Name="StepProgress" MinValue="0" MaxValue="1" Value="0" SetHeight="16" />
                <Label Name="ProgressLabel" Align="Center" />
                <Label Name="GraftLabel" />
                <Control VerticalExpand="True" />
                <Label Name="NoticeLabel"
                       Visible="False"
                       Align="Center"
                       FontColorOverride="#E6C15D" />
                <Button Name="ExecuteButton"
                        Text="{Loc 'nc-medical-surgery-console-execute'}"
                        StyleClasses="ButtonBig"
                        Disabled="True" />
                <Button Name="ClearButton" Text="{Loc 'nc-medical-surgery-console-clear'}" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
