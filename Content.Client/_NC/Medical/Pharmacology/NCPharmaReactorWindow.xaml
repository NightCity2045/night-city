<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCPharmaReactorWindow"
                      Title="{Loc 'nc-pharma-reactor-title'}"
                      SetSize="560 700" MinSize="520 620">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
        <Label Text="{Loc 'nc-pharma-reactor-section-run'}" StyleClasses="LabelHeading" />
        <Label Name="SourceLabel" />
        <OptionButton Name="FormulaSelector" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-station-units'}" />
            <Button Name="UnitsDown" Text="−" MinWidth="38" />
            <Label Name="UnitsValue" MinWidth="40" Align="Center" />
            <Button Name="UnitsUp" Text="+" MinWidth="38" />
            <Button Name="StartButton" Text="{Loc 'nc-pharma-reactor-start'}" HorizontalExpand="True" />
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-reactor-section-gauges'}" StyleClasses="LabelHeading" />
        <RichTextLabel Name="WindowsLabel" />
        <Label Name="TemperatureLabel" />
        <ProgressBar Name="TemperatureBar" MinValue="0" MaxValue="1" MinHeight="12" />
        <Label Name="PressureLabel" />
        <ProgressBar Name="PressureBar" MinValue="0" MaxValue="1" MinHeight="12" />
        <Label Name="MixingLabel" />
        <Label Name="ProgressLabel" />
        <ProgressBar Name="ProgressBar" MinValue="0" MaxValue="1" MinHeight="12" />
        <Label Name="InstabilityLabel" />
        <ProgressBar Name="InstabilityBar" MinValue="0" MaxValue="1" MinHeight="12" />
        <RichTextLabel Name="WarningsLabel" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-reactor-section-controls'}" StyleClasses="LabelHeading" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-reactor-heater'}" MinWidth="120" />
            <Button Name="HeaterDown" Text="−" MinWidth="38" />
            <Label Name="HeaterValue" MinWidth="30" Align="Center" />
            <Button Name="HeaterUp" Text="+" MinWidth="38" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-reactor-cooler'}" MinWidth="120" />
            <Button Name="CoolerDown" Text="−" MinWidth="38" />
            <Label Name="CoolerValue" MinWidth="30" Align="Center" />
            <Button Name="CoolerUp" Text="+" MinWidth="38" />
        </BoxContainer>
        <CheckBox Name="StirringCheck" Text="{Loc 'nc-pharma-reactor-stirring'}" />
        <CheckBox Name="VentingCheck" Text="{Loc 'nc-pharma-reactor-venting'}" />
        <CheckBox Name="VentilationCheck" Text="{Loc 'nc-pharma-reactor-ventilation'}" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="CatalystButton" Text="{Loc 'nc-pharma-reactor-catalyst'}" HorizontalExpand="True" />
            <Button Name="QuenchButton" Text="{Loc 'nc-pharma-reactor-quench'}" HorizontalExpand="True" />
            <Button Name="StopButton" Text="{Loc 'nc-pharma-reactor-stop'}" HorizontalExpand="True" />
        </BoxContainer>
        <Label Name="NoticeLabel" FontColorOverride="#FFC95C" />
    </BoxContainer>
</controls:FancyWindow>
