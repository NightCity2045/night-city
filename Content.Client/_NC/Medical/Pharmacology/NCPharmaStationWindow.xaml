<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCPharmaStationWindow"
                      Title="{Loc 'nc-pharma-station-title'}"
                      SetSize="520 560" MinSize="460 480">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Text="{Loc 'nc-pharma-station-material'}" StyleClasses="LabelHeading" />
        <Label Name="SourceLabel" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-station-formula'}" StyleClasses="LabelHeading" />
        <OptionButton Name="FormulaSelector" HorizontalExpand="True" />
        <RichTextLabel Name="FormulaCard" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-station-profile'}" StyleClasses="LabelHeading" />
        <OptionButton Name="ProfileSelector" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-station-units'}" />
            <Button Name="UnitsDown" Text="−" MinWidth="38" />
            <Label Name="UnitsValue" MinWidth="40" Align="Center" />
            <Button Name="UnitsUp" Text="+" MinWidth="38" />
        </BoxContainer>
        <RichTextLabel Name="Forecast" />
        <ProgressBar Name="Progress" MinValue="0" MaxValue="1" MinHeight="14" />
        <Button Name="StartButton" Text="{Loc 'nc-pharma-station-start'}" />
        <Label Name="NoticeLabel" FontColorOverride="#FFC95C" />
    </BoxContainer>
</controls:FancyWindow>
