<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCLabMachineWindow"
                      SetSize="380 420" MinSize="300 300">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
        <Label Name="StatusLabel" StyleClasses="LabelHeading" />
        <ProgressBar Name="Progress" MinHeight="16" MaxValue="1" />
        <Label Name="RemainingLabel" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-lab-machine-ui-slots'}" StyleClasses="LabelHeading" />
        <BoxContainer Name="SlotList" Orientation="Vertical" SeparationOverride="4" />
        <Label Name="ReadoutHeading" Text="{Loc 'nc-lab-machine-ui-readings'}" StyleClasses="LabelHeading" />
        <BoxContainer Name="ReadoutList" Orientation="Vertical" SeparationOverride="2" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Button Name="StartButton" HorizontalExpand="True" />
            <Button Name="CancelButton" Text="{Loc 'nc-lab-machine-ui-cancel'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
