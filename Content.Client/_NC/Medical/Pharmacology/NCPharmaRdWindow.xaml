<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCPharmaRdWindow"
                      Title="{Loc 'nc-pharma-rd-title'}"
                      SetSize="1280 780" MinSize="1020 620">
    <BoxContainer Orientation="Horizontal" Margin="10" SeparationOverride="10">
        <BoxContainer Orientation="Vertical" MinWidth="230" MaxWidth="230" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-rd-formulas'}" StyleClasses="LabelHeading" />
            <ItemList Name="FormulaList" VerticalExpand="True" />
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-rd-selected'}" StyleClasses="LabelHeading" />
            <RichTextLabel Name="SelectedCard" />
            <PanelContainer StyleClasses="LowDivider" />
            <Label Text="{Loc 'nc-pharma-rd-tree'}" StyleClasses="LabelHeading" />
            <BoxContainer Name="TreeColumns" Orientation="Horizontal" SeparationOverride="6"
                          VerticalExpand="True" MinHeight="250" />
            <RichTextLabel Name="NodeInfo" />
            <RichTextLabel Name="ForecastLabel" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="CreateButton" Text="{Loc 'nc-pharma-rd-create'}" HorizontalExpand="True" />
                <Button Name="ApproveButton" Text="{Loc 'nc-pharma-rd-approve'}" HorizontalExpand="True" />
            </BoxContainer>
            <Label Name="NoticeLabel" FontColorOverride="#FFC95C" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <LineEdit Name="NoteEdit" HorizontalExpand="True" PlaceHolder="{Loc 'nc-pharma-rd-note-placeholder'}" />
                <Button Name="NoteButton" Text="{Loc 'nc-pharma-rd-note-save'}" />
            </BoxContainer>
            <Label Text="{Loc 'nc-pharma-rd-journal'}" StyleClasses="LabelHeading" />
            <ScrollContainer MinHeight="90" MaxHeight="130" HScrollEnabled="False">
                <RichTextLabel Name="JournalLabel" />
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
