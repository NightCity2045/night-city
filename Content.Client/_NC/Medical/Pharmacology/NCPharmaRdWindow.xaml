<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCPharmaRdWindow"
                      Title="{Loc 'nc-pharma-rd-title'}"
                      SetSize="980 640" MinSize="820 520">
    <BoxContainer Orientation="Horizontal" Margin="10" SeparationOverride="10">
        <BoxContainer Orientation="Vertical" MinWidth="260" MaxWidth="260" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-rd-formulas'}" StyleClasses="LabelHeading" />
            <ItemList Name="FormulaList" VerticalExpand="True" />
        </BoxContainer>
        <PanelContainer StyleClasses="LowDivider" />
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
            <Label Text="{Loc 'nc-pharma-rd-selected'}" StyleClasses="LabelHeading" />
            <RichTextLabel Name="SelectedCard" />
            <PanelContainer StyleClasses="LowDivider" />
            <Label Text="{Loc 'nc-pharma-rd-new-version'}" StyleClasses="LabelHeading" />
            <LineEdit Name="NameEdit" PlaceHolder="{Loc 'nc-pharma-rd-name-placeholder'}" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'nc-pharma-rd-delivery'}" MinWidth="110" />
                <OptionButton Name="DeliverySelector" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'nc-pharma-rd-concentration'}" MinWidth="110" />
                <Button Name="ConcentrationDown" Text="−" MinWidth="38" />
                <Label Name="ConcentrationValue" MinWidth="60" Align="Center" />
                <Button Name="ConcentrationUp" Text="+" MinWidth="38" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'nc-pharma-rd-modifier-first'}" MinWidth="110" />
                <OptionButton Name="FirstModifier" HorizontalExpand="True" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Label Text="{Loc 'nc-pharma-rd-modifier-second'}" MinWidth="110" />
                <OptionButton Name="SecondModifier" HorizontalExpand="True" />
            </BoxContainer>
            <RichTextLabel Name="ForecastLabel" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                <Button Name="CreateButton" Text="{Loc 'nc-pharma-rd-create'}" HorizontalExpand="True" />
                <Button Name="ApproveButton" Text="{Loc 'nc-pharma-rd-approve'}" HorizontalExpand="True" />
            </BoxContainer>
            <Label Name="NoticeLabel" FontColorOverride="#FFC95C" />
            <PanelContainer StyleClasses="LowDivider" />
            <Label Text="{Loc 'nc-pharma-rd-journal'}" StyleClasses="LabelHeading" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <RichTextLabel Name="JournalLabel" />
            </ScrollContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
