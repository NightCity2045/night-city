<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Medical.Pharmacology.NCPharmaQcWindow"
                      Title="{Loc 'nc-pharma-qc-title'}"
                      SetSize="500 560" MinSize="440 480">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Text="{Loc 'nc-pharma-qc-sample'}" StyleClasses="LabelHeading" />
        <RichTextLabel Name="SampleLabel" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-qc-tests'}" StyleClasses="LabelHeading" />
        <CheckBox Name="ConcentrationCheck" Text="{Loc 'nc-pharma-qc-test-concentration'}" Pressed="True" />
        <CheckBox Name="PurityCheck" Text="{Loc 'nc-pharma-qc-test-purity'}" Pressed="True" />
        <CheckBox Name="SterilityCheck" Text="{Loc 'nc-pharma-qc-test-sterility'}" Pressed="True" />
        <CheckBox Name="HomogeneityCheck" Text="{Loc 'nc-pharma-qc-test-homogeneity'}" Pressed="True" />
        <CheckBox Name="StabilityCheck" Text="{Loc 'nc-pharma-qc-test-stability'}" Pressed="True" />
        <ProgressBar Name="Progress" MinValue="0" MaxValue="1" MinHeight="14" />
        <Button Name="RunButton" Text="{Loc 'nc-pharma-qc-run'}" />
        <Label Name="NoticeLabel" FontColorOverride="#FFC95C" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-pharma-qc-result'}" StyleClasses="LabelHeading" />
        <RichTextLabel Name="ResultLabel" VerticalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
