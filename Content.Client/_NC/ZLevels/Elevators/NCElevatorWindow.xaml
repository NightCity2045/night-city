<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.ZLevels.Elevators.NCElevatorWindow"
    Title="{Loc 'nc-elevator-title'}" MinSize="260 210" SetSize="280 230">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
        <Label Name="FloorLabel" StyleClasses="LabelHeadingBigger" />
        <Label Name="StatusLabel" />
        <Label Name="DurationLabel" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="UpButton" Text="{Loc 'nc-elevator-up'}" HorizontalExpand="True" MinHeight="42" Disabled="True" />
            <Button Name="DownButton" Text="{Loc 'nc-elevator-down'}" HorizontalExpand="True" MinHeight="42" Disabled="True" />
        </BoxContainer>
        <Label Name="FeedbackLabel" MaxWidth="250" />
    </BoxContainer>
</controls:FancyWindow>
