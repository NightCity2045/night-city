<missions:NCFixerMissionControl xmlns="https://spacestation14.io"
    xmlns:missions="clr-namespace:Content.Client._NC.Missions"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Horizontal" SeparationOverride="4">
        <Button Name="ReputationButton" Text="{Loc 'nc-fixer-reputation'}" HorizontalExpand="True" />
        <Button Name="RefreshButton" Text="{Loc 'nc-agent-missions-refresh'}" />
    </BoxContainer>
    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <PanelContainer Name="ReputationPanel" Margin="0 8">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#071015" BorderColor="#24E0D0" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="10 8">
                    <Label Text="{Loc 'nc-fixer-reputation'}" FontColorOverride="#77FFF2" />
                    <RichTextLabel Name="ReputationLabel" Margin="0 6" />
                    <RichTextLabel Text="{Loc 'nc-fixer-reputation-help'}" />
                </BoxContainer>
            </PanelContainer>
            <RichTextLabel Name="NoticeLabel" Margin="0 6" />
            <BoxContainer Name="OffersList" Orientation="Vertical" Visible="False" />
            <Button Name="AcceptOfferButton" Text="{Loc 'nc-fixer-accept-offer'}" Visible="False" Disabled="True" />
            <Label Text="{Loc 'nc-fixer-my-work'}" FontColorOverride="#77FFF2" Margin="0 8" />
            <Label Name="EmptyLabel" Text="{Loc 'nc-fixer-work-empty'}" FontColorOverride="#6C918E" Visible="False" />
            <BoxContainer Name="WorkList" Orientation="Vertical" />
            <PanelContainer Margin="0 8">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#071015" BorderColor="#24E0D0" BorderThickness="1 0 0 0" />
                </PanelContainer.PanelOverride>
                <RichTextLabel Name="DetailsLabel" Margin="10 8" />
            </PanelContainer>
        </BoxContainer>
    </ScrollContainer>
    <RichTextLabel Name="TimeLabel" Margin="0 4" />
    <BoxContainer Name="InviteRow" Orientation="Horizontal" Visible="False">
        <OptionButton Name="InviteTarget" HorizontalExpand="True" />
        <Button Name="InviteButton" Text="{Loc 'nc-fixer-invite'}" />
    </BoxContainer>
    <BoxContainer Orientation="Vertical" SeparationOverride="4">
        <Button Name="JoinButton" Text="{Loc 'nc-fixer-join'}" Visible="False" />
        <Button Name="DeclineButton" Text="{Loc 'nc-fixer-decline'}" Visible="False" />
        <Button Name="LaunchButton" Text="{Loc 'nc-fixer-launch'}" Visible="False" />
        <controls:ConfirmButton Name="CancelButton" Text="{Loc 'nc-contract-cancel'}"
            ConfirmationText="{Loc 'nc-contract-confirm'}" Visible="False" />
        <Button Name="DeliverButton" Text="{Loc 'nc-fixer-deliver'}" Visible="False" />
    </BoxContainer>
</missions:NCFixerMissionControl>
