<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Missions.NCMissionConsoleWindow"
                      Title="{Loc 'nc-mission-console-title'}"
                      SetSize="600 390">
    <BoxContainer Margin="12" Orientation="Vertical" SeparationOverride="9">
        <Label Text="{Loc 'nc-mission-console-heading'}" StyleClasses="LabelHeading" />
        <Label Text="{Loc 'nc-mission-console-public-warning'}"
               FontColorOverride="#E6C15D"
               HorizontalExpand="True" />
        <PanelContainer StyleClasses="LowDivider" />

        <GridContainer Columns="2" HSeparationOverride="12" VSeparationOverride="7">
            <Label Text="{Loc 'nc-mission-console-mission'}" StyleClasses="LabelKeyText" />
            <Label Name="MissionLabel" />
            <Label Text="{Loc 'nc-mission-console-slot'}" StyleClasses="LabelKeyText" />
            <Label Name="SlotLabel" />
            <Label Text="{Loc 'nc-mission-console-state'}" StyleClasses="LabelKeyText" />
            <Label Name="StateLabel" />
            <Label Text="{Loc 'nc-mission-console-time-left'}" StyleClasses="LabelKeyText" />
            <Label Name="TimerLabel" />
        </GridContainer>

        <Label Name="EvacuationWarningLabel"
               Text="{Loc 'nc-mission-console-evacuation-warning'}"
               Visible="False"
               Align="Center"
               FontColorOverride="#FF6B57" />
        <Label Name="NoticeLabel"
               Visible="False"
               Align="Center"
               FontColorOverride="#E6C15D" />

        <Control VerticalExpand="True" />
        <Button Name="StartButton"
                Text="{Loc 'nc-mission-console-start'}"
                Disabled="True" />
        <controls:ConfirmButton Name="FinishButton"
                                Text="{Loc 'nc-mission-console-finish'}"
                                ConfirmationText="{Loc 'nc-mission-console-finish-confirm'}"
                                Visible="False"
                                Disabled="True" />
    </BoxContainer>
</controls:FancyWindow>
