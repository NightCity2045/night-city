<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vehicle="clr-namespace:Content.Client._NC.Vehicle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.Vehicle.NCVehicleDriverWindow"
    Title="{Loc 'nc-vehicle-dashboard'}" MinWidth="330">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="Telemetry" />
        <RichTextLabel Name="EngineStatus" MaxWidth="440" />
        <Label Name="Pedals" />
        <RichTextLabel Name="ShiftStatus" MaxWidth="440" />
        <Label Name="Condition" />
        <Label Name="Fluids" />
        <Label Name="Accessories" />
        <Label Text="{Loc 'nc-vehicle-steering'}" />
        <Label Text="{Loc 'nc-vehicle-steering-grip'}" />
        <vehicle:NCVehicleSteeringWheel Name="Steering" MinHeight="160" MinWidth="160" HorizontalAlignment="Center" />
        <Label Name="GearGate" />
        <vehicle:NCVehicleGearGate Name="Shifter" MinHeight="130" MinWidth="250" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal">
            <Button Name="Ignition" Text="{Loc 'nc-vehicle-ignition'}" />
            <Button Name="Neutral" Text="{Loc 'nc-vehicle-neutral'}" />
            <Button Name="Reverse" Text="{Loc 'nc-vehicle-reverse'}" />
        </BoxContainer>
        <BoxContainer Orientation="Horizontal">
            <Button Name="LeftGate" Text="{Loc 'nc-vehicle-gear-left'}" />
            <Button Name="LowerGear" Text="{Loc 'nc-vehicle-gear-down'}" />
            <Button Name="HigherGear" Text="{Loc 'nc-vehicle-gear-up'}" />
            <Button Name="RightGate" Text="{Loc 'nc-vehicle-gear-right'}" />
            <Button Name="Exit" Text="{Loc 'nc-vehicle-exit'}" />
        </BoxContainer>
        <RichTextLabel Name="Instructions" MaxWidth="440" />
        <BoxContainer Orientation="Horizontal">
            <Button Name="Lights" Text="{Loc 'nc-vehicle-lights'}" />
            <Button Name="Horn" Text="{Loc 'nc-vehicle-horn'}" />
            <Button Name="Wash" Text="{Loc 'nc-vehicle-wash'}" />
        </BoxContainer>
        <RichTextLabel Name="LaunchInstructions" MaxWidth="440" />
        <BoxContainer Orientation="Horizontal">
            <Button Name="Park" Text="{Loc 'nc-vehicle-park'}" />
            <Button Name="Travel" Text="{Loc 'nc-vehicle-travel'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
