<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.Vehicle.NCVehicleOwnershipWindow"
    Title="{Loc 'nc-vehicle-ownership'}" MinWidth="440">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="OwnerLabel" />
        <Label Name="OfferLabel" />
        <LineEdit Name="Price" PlaceHolder="{Loc 'nc-vehicle-sale-price'}" />
        <BoxContainer Orientation="Horizontal">
            <Button Name="Offer" Text="{Loc 'nc-vehicle-sale-offer'}" />
            <Button Name="Withdraw" Text="{Loc 'nc-vehicle-sale-withdraw'}" />
        </BoxContainer>
        <Button Name="Accept" Text="{Loc 'nc-vehicle-sale-accept'}" />
        <Button Name="Rekey" Text="{Loc 'nc-vehicle-rekey'}" />
        <RichTextLabel Name="Instructions" MaxWidth="460" />
    </BoxContainer>
</controls:FancyWindow>
