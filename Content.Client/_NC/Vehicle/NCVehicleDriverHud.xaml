<LayoutContainer xmlns="https://spacestation14.io"
    xmlns:vehicle="clr-namespace:Content.Client._NC.Vehicle"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.Vehicle.NCVehicleDriverHud"
    MouseFilter="Ignore">
    <BoxContainer Name="Console" Orientation="Vertical" SeparationOverride="2">
        <PanelContainer StyleClasses="AngleRect" HorizontalAlignment="Center">
            <BoxContainer Orientation="Vertical" MinWidth="560" MaxWidth="640" Margin="8 2">
                <RichTextLabel Name="EngineStatus" HorizontalAlignment="Center" MouseFilter="Ignore" />
                <RichTextLabel Name="DrivingHint" HorizontalAlignment="Center" MouseFilter="Ignore" />
            </BoxContainer>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="2">
            <PanelContainer StyleClasses="AngleRect" SetSize="150 150">
                <vehicle:NCVehicleGearGate Name="Shifter" SetSize="150 150"
                    ToolTip="{Loc 'nc-vehicle-hud-shifter-tooltip'}" />
            </PanelContainer>
            <PanelContainer StyleClasses="AngleRect" SetSize="340 150">
                <vehicle:NCVehicleInstrumentCluster Name="Instruments" SetSize="340 150" />
            </PanelContainer>
            <PanelContainer StyleClasses="AngleRect" SetSize="150 150">
                <vehicle:NCVehicleSteeringWheel Name="Steering" SetSize="150 150"
                    ToolTip="{Loc 'nc-vehicle-steering-grip'}" />
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="3">
            <vehicle:NCVehiclePedalDisplay Name="Pedals" SetSize="115 52"
                ToolTip="{Loc 'nc-vehicle-hud-pedals-tooltip'}" />
            <Button Name="Ignition" Text="&#x23FB;" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-ignition'}" />
            <Button Name="Neutral" Text="N" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-neutral'}" />
            <Button Name="Reverse" Text="R" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-reverse'}" />
            <Button Name="Lights" Text="&#x2600;" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-lights'}" />
            <Button Name="Horn" Text="!" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-horn'}" />
            <Button Name="Seatbelt" Text="&#x25A3;" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-seatbelt-fasten'}" />
            <Button Name="Exit" Text="&#x2197;" SetSize="44 36" ToolTip="{Loc 'nc-vehicle-exit'}" />
            <Button Name="More" Text="..." SetSize="44 36" ToolTip="{Loc 'nc-vehicle-hud-more-tooltip'}" />
        </BoxContainer>
        <BoxContainer Name="MoreControls" Orientation="Horizontal" HorizontalAlignment="Center"
            SeparationOverride="3" Visible="False">
            <Button Name="Wash" Text="{Loc 'nc-vehicle-wash'}" />
            <Button Name="Park" Text="{Loc 'nc-vehicle-park'}" />
            <Button Name="Travel" Text="{Loc 'nc-vehicle-travel'}" />
        </BoxContainer>
    </BoxContainer>
</LayoutContainer>
