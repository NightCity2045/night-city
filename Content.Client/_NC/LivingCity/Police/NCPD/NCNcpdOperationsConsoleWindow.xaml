<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:agent="clr-namespace:Content.Client._NC.Agent"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._NC.LivingCity.Police.NCPD.NCNcpdOperationsConsoleWindow"
    Title="{Loc 'nc-ncpd-operations-title'}"
    SetSize="1240 780">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101B26" BorderColor="#4678B8" BorderThickness="1" /></PanelContainer.PanelOverride>
            <BoxContainer Margin="10 7" Orientation="Horizontal" SeparationOverride="12">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <Label Text="{Loc 'nc-ncpd-operations-heading'}" StyleClasses="LabelHeading" FontColorOverride="#A9D8FF" />
                    <Label Name="AuthorityLabel" FontColorOverride="#8AA8BF" />
                </BoxContainer>
                <Button Name="RefreshButton" Text="{Loc 'nc-ncpd-operations-refresh'}" MinWidth="110" />
            </BoxContainer>
        </PanelContainer>
        <Label Name="NoticeLabel" FontColorOverride="#F0C765" />

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="8">
            <BoxContainer Orientation="Vertical" MinWidth="300" MaxWidth="300" SeparationOverride="5">
                <Label Text="{Loc 'nc-ncpd-operations-units'}" StyleClasses="LabelHeading" FontColorOverride="#A9D8FF" />
                <Label Text="{Loc 'nc-ncpd-operations-units-help'}" FontColorOverride="#718C9F" />
                <ItemList Name="UnitList" VerticalExpand="True" />
                <Label Name="UnitDetails" MinHeight="76" FontColorOverride="#BFD1DD" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" />

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="5">
                <Label Text="{Loc 'nc-ncpd-operations-map'}" StyleClasses="LabelHeading" FontColorOverride="#A9D8FF" />
                <agent:NCAgentMapControl Name="CityMap" MinHeight="300" VerticalExpand="True" HorizontalExpand="True" />
                <Label Text="{Loc 'nc-ncpd-operations-zone'}" StyleClasses="LabelSubHeading" />
                <LineEdit Name="ZoneFilter" PlaceHolder="{Loc 'nc-ncpd-operations-zone-filter'}" />
                <ItemList Name="ZoneList" MinHeight="135" MaxHeight="155" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" />

            <BoxContainer Orientation="Vertical" MinWidth="330" MaxWidth="330" SeparationOverride="6">
                <Label Text="{Loc 'nc-ncpd-operations-order'}" StyleClasses="LabelHeading" FontColorOverride="#A9D8FF" />
                <Label Name="SelectedUnitLabel" Text="{Loc 'nc-ncpd-operations-select-unit'}" />
                <OptionButton Name="OrderSelector" />
                <Label Text="{Loc 'nc-ncpd-operations-priority'}" StyleClasses="LabelKeyText" />
                <LineEdit Name="PriorityEdit" Text="500" />
                <Label Text="{Loc 'nc-ncpd-operations-reason'}" StyleClasses="LabelKeyText" />
                <TextEdit Name="ReasonEdit" MinHeight="110" />
                <Button Name="IssueButton" Text="{Loc 'nc-ncpd-operations-issue'}" Disabled="True" />
                <Button Name="CancelButton" Text="{Loc 'nc-ncpd-operations-cancel'}" Disabled="True" />
                <PanelContainer StyleClasses="LowDivider" />
                <Label Text="{Loc 'nc-ncpd-operations-history'}" StyleClasses="LabelHeading" FontColorOverride="#A9D8FF" />
                <ItemList Name="CommandList" VerticalExpand="True" />
                <Label Name="CommandDetails" MinHeight="92" FontColorOverride="#BFD1DD" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
