<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.LivingCity.Economy.Shop.NCEconomicShopWindow"
                      Title="{Loc 'nc-economic-shop-window-title'}"
                      MinSize="900 600"
                      SetSize="1050 740">
    <PanelContainer HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#05090D" BorderColor="#284B55" BorderThickness="2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="9">
            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#101B22" BorderColor="#FFB32C" BorderThickness="0 0 0 3" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="12 8">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <Label Text="{Loc 'nc-economic-shop-network'}" FontColorOverride="#FFB32C" />
                        <Label Name="ShopNameLabel" StyleClasses="LabelHeading" FontColorOverride="#F4F7F8" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Right">
                        <Label Text="{Loc 'nc-economic-shop-balance'}" FontColorOverride="#668A92"
                               HorizontalAlignment="Right" />
                        <Label Name="BalanceLabel" FontColorOverride="#72F4FF" HorizontalAlignment="Right" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer Name="NoticePanel" Visible="False" HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#11251D" BorderColor="#63D17C" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <Label Name="NoticeLabel" Margin="8 5" Align="Center" FontColorOverride="#8CFFAA" />
            </PanelContainer>

            <PanelContainer Name="LoadingPanel" VerticalExpand="True" HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#071116" BorderColor="#1B5C69" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center"
                              SeparationOverride="8">
                    <Label Text="[ /// ]" FontColorOverride="#72F4FF" Align="Center" />
                    <Label Name="StatusLabel" Text="{Loc 'nc-economic-shop-loading'}"
                           FontColorOverride="#8CB7BF" Align="Center" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Name="CatalogPanel" Visible="False" Orientation="Vertical" VerticalExpand="True"
                          SeparationOverride="9">
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#09151B" BorderColor="#21434B" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal" Margin="8 6" SeparationOverride="8">
                        <OptionButton Name="CategorySelector" MinSize="230 0" />
                        <LineEdit Name="SearchEdit" HorizontalExpand="True"
                                  PlaceHolder="{Loc 'nc-economic-shop-search'}" />
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="10">
                    <PanelContainer MinWidth="540" HorizontalExpand="True" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#071015" BorderColor="#1C3B43" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'nc-economic-shop-stock'}" FontColorOverride="#72F4FF"
                                       HorizontalExpand="True" />
                                <Label Name="ListingCountLabel" FontColorOverride="#537982" />
                            </BoxContainer>
                            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                                <GridContainer Name="ListingGrid" Columns="2" HSeparationOverride="7"
                                               VSeparationOverride="7" HorizontalExpand="True" />
                            </ScrollContainer>
                            <Label Name="EmptyLabel" Text="{Loc 'nc-economic-shop-empty'}" Visible="False"
                                   Align="Center" FontColorOverride="#668087" />
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer MinWidth="310" MaxWidth="330" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#0B1319" BorderColor="#FFB32C" BorderThickness="1 1 3 1" />
                        </PanelContainer.PanelOverride>
                        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                            <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8"
                                          HorizontalExpand="True">
                                <Label Text="{Loc 'nc-economic-shop-order-heading'}" FontColorOverride="#FFB32C" />
                                <PanelContainer MinHeight="128" HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#050B0F" BorderColor="#274852" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <EntityPrototypeView Name="SelectedPreview" Visible="False" SetSize="112 112"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </PanelContainer>
                                <Label Name="ProductNameLabel" Text="{Loc 'nc-economic-shop-select-item'}"
                                       FontColorOverride="#F4F7F8" />
                                <Label Name="ProductCategoryLabel" FontColorOverride="#72F4FF" />
                                <RichTextLabel Name="DescriptionLabel" MaxWidth="292" HorizontalExpand="True" />
                                <PanelContainer MinHeight="92" HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#08151A" BorderColor="#1D353C" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <GridContainer Columns="2" Margin="8 8" HSeparationOverride="12" VSeparationOverride="7">
                                        <Label Text="{Loc 'nc-economic-shop-stock-label'}" FontColorOverride="#587982" />
                                        <Label Name="StockValueLabel" HorizontalAlignment="Right" FontColorOverride="#D5E7EA" />
                                        <Label Text="{Loc 'nc-economic-shop-quality-label'}" FontColorOverride="#587982" />
                                        <Label Name="QualityValueLabel" HorizontalAlignment="Right" FontColorOverride="#D5E7EA" />
                                        <Label Text="{Loc 'nc-economic-shop-unit-price-label'}" FontColorOverride="#587982" />
                                        <Label Name="PriceValueLabel" HorizontalAlignment="Right" FontColorOverride="#FFCF66" />
                                    </GridContainer>
                                </PanelContainer>
                                <Label Text="{Loc 'nc-economic-shop-quantity'}" FontColorOverride="#668A92" />
                                <LineEdit Name="QuantityEdit" Text="1" />
                                <BoxContainer Orientation="Horizontal">
                                    <Label Text="{Loc 'nc-economic-shop-total-label'}" FontColorOverride="#668A92"
                                           HorizontalExpand="True" />
                                    <Label Name="OrderTotalLabel" FontColorOverride="#FFCF66" />
                                </BoxContainer>
                                <Button Name="PurchaseButton" Text="{Loc 'nc-economic-shop-purchase'}"
                                        MinHeight="38" HorizontalExpand="True" />
                                <RichTextLabel Text="{Loc 'nc-economic-shop-price-note'}" Modulate="#526970"
                                               MaxWidth="292" HorizontalExpand="True" />
                            </BoxContainer>
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
