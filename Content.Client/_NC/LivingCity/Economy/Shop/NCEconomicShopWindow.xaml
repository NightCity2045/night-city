<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.LivingCity.Economy.Shop.NCEconomicShopWindow"
                      Title="{Loc 'nc-economic-shop-window-title'}"
                      SetSize="620 590">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Name="ShopNameLabel" StyleClasses="LabelHeading" Align="Center" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'nc-economic-shop-balance'}" StyleClasses="LabelKeyText" />
            <Label Name="BalanceLabel" />
        </BoxContainer>
        <Label Name="StatusLabel" Align="Center" FontColorOverride="#E6A65D" />
        <Label Name="NoticeLabel" Align="Center" FontColorOverride="#63D17C" />
        <PanelContainer StyleClasses="LowDivider" />
        <Label Text="{Loc 'nc-economic-shop-stock'}" StyleClasses="LabelHeading" />
        <ItemList Name="ListingList" VerticalExpand="True" MinHeight="350" />
        <Label Name="EmptyLabel" Text="{Loc 'nc-economic-shop-empty'}" Align="Center" FontColorOverride="DarkGray" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="QuantityEdit" Text="1" PlaceHolder="{Loc 'nc-economic-shop-quantity'}" MinSize="100 0" />
            <Button Name="PurchaseButton" Text="{Loc 'nc-economic-shop-purchase'}" HorizontalExpand="True" />
        </BoxContainer>
        <Label Text="{Loc 'nc-economic-shop-price-note'}" FontColorOverride="DarkGray" />
    </BoxContainer>
</controls:FancyWindow>
