<admin:NCLivingCityAdminTab xmlns="https://spacestation14.io"
    xmlns:admin="clr-namespace:Content.Client._NC.LivingCity.Admin"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <PanelContainer HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#0A1016" /></PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="18" SeparationOverride="10">
            <Label Text="{Loc nc-living-city-admin-title}" StyleClasses="LabelHeading" FontColorOverride="#D8F7FF" />
            <Label Text="{Loc nc-living-city-admin-random-resident-help}" FontColorOverride="#7FA5B2" />
            <Button Name="CreateRandomResident" Access="Public"
                Text="{Loc nc-living-city-admin-create-random-resident}" MinWidth="260" />
            <Label Name="Status" Access="Public" Text="" FontColorOverride="#F3C969" />
            <Label Name="Result" Access="Public" Text="" FontColorOverride="#D8F7FF" />
        </BoxContainer>
    </PanelContainer>
</admin:NCLivingCityAdminTab>
