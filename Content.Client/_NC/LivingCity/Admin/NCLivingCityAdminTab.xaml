<admin:NCLivingCityAdminTab xmlns="https://spacestation14.io"
    xmlns:admin="clr-namespace:Content.Client._NC.LivingCity.Admin"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <PanelContainer HorizontalExpand="True" VerticalExpand="True" RectClipContent="True">
        <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#0A1016" /></PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer MinHeight="54" HorizontalExpand="True">
                <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#111C25" BorderColor="#3B8398" BorderThickness="0 0 0 2" /></PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="14 7">
                    <Label Text="{Loc nc-living-city-admin-title}" StyleClasses="LabelHeading" FontColorOverride="#D8F7FF" />
                    <Label Text="{Loc nc-living-city-admin-subtitle}" FontColorOverride="#7FA5B2" />
                </BoxContainer>
            </PanelContainer>

            <TabContainer Name="Tabs" Access="Public" VerticalExpand="True" HorizontalExpand="True">
                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#10202A" BorderColor="#2E7588" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Horizontal" Margin="12 9" SeparationOverride="8">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Text="{Loc nc-living-city-admin-city-health}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                    <Label Name="OverviewStatus" Access="Public" Text="{Loc nc-living-city-admin-loading}" FontColorOverride="#F3C969" />
                                </BoxContainer>
                                <Button Name="RefreshOverview" Access="Public" Text="{Loc nc-living-city-admin-refresh}" MinWidth="120" />
                            </BoxContainer>
                        </PanelContainer>
                        <Label Text="{Loc nc-living-city-admin-overview-help}" FontColorOverride="#7896A1" />
                        <BoxContainer Name="OverviewFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-inspector-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <Label Name="InspectHint" Access="Public" Text="{Loc nc-living-city-admin-inspector-help}" FontColorOverride="#7896A1" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-inspect-kind}" StyleClasses="LabelKeyText" />
                                    <OptionButton Name="InspectKind" Access="Public" HorizontalExpand="True" />
                                    <Label Text="{Loc nc-living-city-admin-target}" StyleClasses="LabelKeyText" />
                                    <LineEdit Name="InspectTarget" Access="Public" PlaceHolder="{Loc nc-living-city-admin-target-placeholder}" HorizontalExpand="True" />
                                    <Label Name="InspectSecondaryLabel" Access="Public" Text="{Loc nc-living-city-admin-secondary-target}" StyleClasses="LabelKeyText" Visible="False" />
                                    <LineEdit Name="InspectSecondaryTarget" Access="Public" PlaceHolder="{Loc nc-living-city-admin-secondary-placeholder}" HorizontalExpand="True" Visible="False" />
                                </GridContainer>
                                <Button Name="RunInspection" Access="Public" Text="{Loc nc-living-city-admin-inspect}" MinWidth="150" />
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="InspectStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="InspectionFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <Label Text="{Loc nc-living-city-admin-actors-help}" FontColorOverride="#7896A1" />
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-actor-create-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-population-scope}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorPopulationScope" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-stable-local-id}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorStableLocalId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-archetype}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorArchetype" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-home-zone}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorHomeZone" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-work-zone}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorWorkZone" Access="Public" Text="none" />
                                    <Label Text="{Loc nc-living-city-admin-full-name}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorFullName" Access="Public" />
                                </GridContainer>
                                <controls:ConfirmButton Name="CreateActor" Access="Public" Text="{Loc nc-living-city-admin-create-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-actor-actions-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-actor-id}" StyleClasses="LabelKeyText" /><LineEdit Name="ActionActorId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-target-zone}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorTargetZone" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-priority}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorPriority" Access="Public" Text="900" />
                                    <Label Text="{Loc nc-living-city-admin-reason}" StyleClasses="LabelKeyText" /><LineEdit Name="ActorReason" Access="Public" PlaceHolder="{Loc nc-living-city-admin-reason-placeholder}" />
                                </GridContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <controls:ConfirmButton Name="FreezeActor" Access="Public" Text="{Loc nc-living-city-admin-freeze-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="UnfreezeActor" Access="Public" Text="{Loc nc-living-city-admin-unfreeze-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="MoveActor" Access="Public" Text="{Loc nc-living-city-admin-move-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="CaptureActorDomains" Access="Public" Text="{Loc nc-living-city-admin-capture-domains}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="RestoreActorHealth" Access="Public" Text="{Loc nc-living-city-admin-restore-health}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="MaterializeActor" Access="Public" Text="{Loc nc-living-city-admin-materialize-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="DematerializeActor" Access="Public" Text="{Loc nc-living-city-admin-dematerialize-actor}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="ActorActionStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="ActorActionFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <Label Text="{Loc nc-living-city-admin-groups-help}" FontColorOverride="#7896A1" />
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-group-create-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-group-scope}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupScope" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-stable-local-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupStableLocalId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-display-name}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupDisplayName" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-profile}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupProfile" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-faction-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupFactionId" Access="Public" Text="none" />
                                    <Label Text="{Loc nc-living-city-admin-leader-actor-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupLeaderActorId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-role}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupLeaderRole" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-current-zone}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupCurrentZone" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-purpose}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupPurpose" Access="Public" />
                                </GridContainer>
                                <controls:ConfirmButton Name="CreateGroup" Access="Public" Text="{Loc nc-living-city-admin-create-group}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-group-actions-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-group-id}" StyleClasses="LabelKeyText" /><LineEdit Name="ActionGroupId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-destination-group-id}" StyleClasses="LabelKeyText" /><LineEdit Name="DestinationGroupId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-actor-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupActorId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-successor-actor-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupSuccessorActorId" Access="Public" Text="none" />
                                    <Label Text="{Loc nc-living-city-admin-role}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupRole" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-current-order}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupCurrentOrder" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-mission-reference}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupMissionReference" Access="Public" Text="none" />
                                    <Label Text="{Loc nc-living-city-admin-incident-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupIncidentId" Access="Public" Text="none" />
                                    <Label Text="{Loc nc-living-city-admin-priority}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupPriority" Access="Public" Text="900" />
                                    <Label Text="{Loc nc-living-city-admin-reason}" StyleClasses="LabelKeyText" /><LineEdit Name="GroupReason" Access="Public" PlaceHolder="{Loc nc-living-city-admin-reason-placeholder}" />
                                </GridContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <controls:ConfirmButton Name="AddGroupMember" Access="Public" Text="{Loc nc-living-city-admin-add-group-member}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="RemoveGroupMember" Access="Public" Text="{Loc nc-living-city-admin-remove-group-member}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="TransferGroupMember" Access="Public" Text="{Loc nc-living-city-admin-transfer-group-member}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="SetGroupLeader" Access="Public" Text="{Loc nc-living-city-admin-set-group-leader}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="SetGroupDirective" Access="Public" Text="{Loc nc-living-city-admin-set-group-directive}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="MaterializeGroup" Access="Public" Text="{Loc nc-living-city-admin-materialize-group}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="DematerializeGroup" Access="Public" Text="{Loc nc-living-city-admin-dematerialize-group}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="GroupActionStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="GroupActionFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-population-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <Label Text="{Loc nc-living-city-admin-population-help}" FontColorOverride="#7896A1" />
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                    <Label Text="{Loc nc-living-city-admin-population-profile}" StyleClasses="LabelKeyText" />
                                    <OptionButton Name="PopulationProfile" Access="Public" HorizontalExpand="True" MinWidth="360" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                    <Label Text="{Loc nc-living-city-admin-reason}" StyleClasses="LabelKeyText" />
                                    <LineEdit Name="PopulationReason" Access="Public" HorizontalExpand="True" MinWidth="360" PlaceHolder="{Loc nc-living-city-admin-reason-placeholder}" />
                                </BoxContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Button Name="ValidatePopulationProfile" Access="Public" Text="{Loc nc-living-city-admin-validate-population}" />
                                    <controls:ConfirmButton Name="ImportPopulationProfile" Access="Public" Text="{Loc nc-living-city-admin-import-population}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="RebuildZoneStates" Access="Public" Text="{Loc nc-living-city-admin-rebuild-zone-states}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="PopulationActionStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="PopulationActionFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#241A1B" BorderColor="#9A4E58" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-infrastructure-heading}" StyleClasses="LabelHeading" FontColorOverride="#FFB5BE" />
                                <Label Text="{Loc nc-living-city-admin-infrastructure-help}" FontColorOverride="#B98A90" />
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-recovery-target-id}" StyleClasses="LabelKeyText" /><LineEdit Name="OutboxMessageId" Access="Public" PlaceHolder="{Loc nc-living-city-admin-recovery-target-placeholder}" />
                                    <Label Text="{Loc nc-living-city-admin-reset-outbox-attempts}" StyleClasses="LabelKeyText" /><CheckBox Name="ResetOutboxAttempts" Access="Public" Pressed="True" />
                                    <Label Text="{Loc nc-living-city-admin-reason}" StyleClasses="LabelKeyText" /><LineEdit Name="InfrastructureReason" Access="Public" PlaceHolder="{Loc nc-living-city-admin-reason-placeholder}" />
                                </GridContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <controls:ConfirmButton Name="RequeueOutboxMessage" Access="Public" Text="{Loc nc-living-city-admin-requeue-outbox-message}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="ReconcileEconomy" Access="Public" Text="{Loc nc-living-city-admin-reconcile-economy}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="RebuildDistrictSafety" Access="Public" Text="{Loc nc-living-city-admin-rebuild-district-safety}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="RecoverServiceDispatch" Access="Public" Text="{Loc nc-living-city-admin-recover-service-dispatch}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="ReloadProperty" Access="Public" Text="{Loc nc-living-city-admin-reload-property}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                    <controls:ConfirmButton Name="ResetNeuralCircuit" Access="Public" Text="{Loc nc-living-city-admin-reset-neural-circuit}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="InfrastructureActionStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="InfrastructureActionFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>

                <ScrollContainer VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride><gfx:StyleBoxFlat BackgroundColor="#101C25" BorderColor="#315B70" BorderThickness="1" /></PanelContainer.PanelOverride>
                            <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="7">
                                <Label Text="{Loc nc-living-city-admin-geography-heading}" StyleClasses="LabelHeading" FontColorOverride="#9DE8F8" />
                                <Label Text="{Loc nc-living-city-admin-geography-help}" FontColorOverride="#7896A1" />
                                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                    <Button Name="ValidateGeography" Access="Public" Text="{Loc nc-living-city-admin-validate-geography}" />
                                    <Button Name="ToggleConnectivityOverlay" Access="Public" Text="{Loc nc-living-city-admin-enable-connectivity-overlay}" />
                                </BoxContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Label Text="{Loc nc-living-city-admin-city-zone-id}" StyleClasses="LabelKeyText" /><LineEdit Name="GeographyZoneId" Access="Public" />
                                    <Label Text="{Loc nc-living-city-admin-zone-activity-mode}" StyleClasses="LabelKeyText" /><OptionButton Name="GeographyActivityMode" Access="Public" HorizontalExpand="True" />
                                    <Label Text="{Loc nc-living-city-admin-reason}" StyleClasses="LabelKeyText" /><LineEdit Name="GeographyReason" Access="Public" PlaceHolder="{Loc nc-living-city-admin-reason-placeholder}" />
                                </GridContainer>
                                <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="6">
                                    <Button Name="InspectCityZone" Access="Public" Text="{Loc nc-living-city-admin-inspect-city-zone}" />
                                    <Button Name="InspectConnectivityZone" Access="Public" Text="{Loc nc-living-city-admin-inspect-connectivity-zone}" />
                                    <controls:ConfirmButton Name="SetZoneActivity" Access="Public" Text="{Loc nc-living-city-admin-set-zone-activity}" ConfirmationText="{Loc nc-living-city-admin-confirm-exact-action}" />
                                </GridContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <Label Name="GeographyStatus" Access="Public" Text="" FontColorOverride="#7896A1" />
                        <BoxContainer Name="GeographyFields" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" />
                    </BoxContainer>
                </ScrollContainer>
            </TabContainer>
        </BoxContainer>
    </PanelContainer>
</admin:NCLivingCityAdminTab>
