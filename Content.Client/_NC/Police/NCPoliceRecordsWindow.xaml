<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Police.NCPoliceRecordsWindow"
                      Title="{Loc 'nc-police-records-title'}"
                      SetSize="900 560">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="SearchEdit"
                      PlaceHolder="{Loc 'nc-police-records-search-placeholder'}"
                      HorizontalExpand="True" />
            <Button Name="SearchButton" Text="{Loc 'nc-police-records-search'}" MinWidth="120" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" MinWidth="280" MaxWidth="280">
                <Label Text="{Loc 'nc-police-records-results'}" StyleClasses="LabelHeading" />
                <Label Name="NoResultsLabel"
                       Text="{Loc 'nc-police-records-no-results'}"
                       FontColorOverride="DarkGray"
                       Align="Center" />
                <ItemList Name="ResultsList" VerticalExpand="True" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" />

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                <Label Name="SelectPrompt"
                       Text="{Loc 'nc-police-records-select-prompt'}"
                       FontColorOverride="DarkGray"
                       Align="Center" />

                <BoxContainer Name="RecordContainer"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              VerticalExpand="True"
                              Visible="False"
                              SeparationOverride="6">
                    <Label Name="CharacterNameLabel" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-police-records-job'}" StyleClasses="LabelKeyText" />
                        <Label Name="JobLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-police-records-current-status'}" StyleClasses="LabelKeyText" />
                        <Label Name="CurrentStatusLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-police-records-current-reason'}" StyleClasses="LabelKeyText" />
                        <Label Name="CurrentReasonLabel" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-police-records-updated-by'}" StyleClasses="LabelKeyText" />
                        <Label Name="UpdatedByLabel" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" />

                    <Label Text="{Loc 'nc-police-records-change-status'}" StyleClasses="LabelHeading" />
                    <OptionButton Name="StatusSelector" MinWidth="220" />
                    <LineEdit Name="ReasonEdit"
                              PlaceHolder="{Loc 'nc-police-records-reason-placeholder'}" />
                    <Button Name="ApplyButton" Text="{Loc 'nc-police-records-apply'}" />

                    <PanelContainer StyleClasses="LowDivider" />

                    <Label Text="{Loc 'nc-police-records-history'}" StyleClasses="LabelHeading" />
                    <Label Name="NoHistoryLabel"
                           Text="{Loc 'nc-police-records-no-history'}"
                           FontColorOverride="DarkGray"
                           Align="Center" />
                    <ItemList Name="HistoryList" VerticalExpand="True" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
