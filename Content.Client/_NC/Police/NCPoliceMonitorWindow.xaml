<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:map="clr-namespace:Content.Client._NC.City.Map"
                      Title="{Loc 'nc-police-monitor-title'}"
                      MinSize="520 420"
                      SetSize="900 680">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4">
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="CountLabel" />
            <Label Text="{Loc 'nc-police-monitor-hint'}" FontColorOverride="#888888" HorizontalExpand="True" ClipText="True" />
        </BoxContainer>
        <Label Name="StatusLabel" Visible="False" />
        <map:NCCityMapControl Name="MapControl" HorizontalExpand="True" VerticalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
