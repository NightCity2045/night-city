                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:map="clr-namespace:Content.Client._NC.City.Map"
                      Title="{Loc 'nc-city-map-title'}"
                      MinSize="520 420"
                      SetSize="820 640">
