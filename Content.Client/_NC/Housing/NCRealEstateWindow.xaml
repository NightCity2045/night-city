<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Housing.NCRealEstateWindow"
                      Title="{Loc 'nc-real-estate-title'}"
                      SetSize="640 640"
                      MinSize="480 420">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <Label Name="StatusLabel" FontColorOverride="#E3A59F" Visible="False" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <Label Text="{Loc 'nc-real-estate-balance'}" StyleClasses="LabelKeyText" />
            <Label Name="BalanceLabel" />
            <Control HorizontalExpand="True" />
            <CheckBox Name="MineOnly" Text="{Loc 'nc-real-estate-mine-only'}" />
        </BoxContainer>
        <Label Text="{Loc 'nc-real-estate-hint'}" FontColorOverride="#888888" />
        <PanelContainer StyleClasses="LowDivider" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ListingsContainer" Orientation="Vertical" SeparationOverride="10" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
