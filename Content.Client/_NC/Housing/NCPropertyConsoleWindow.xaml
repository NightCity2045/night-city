<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      x:Class="Content.Client._NC.Housing.NCPropertyConsoleWindow"
                      Title="{Loc 'nc-property-console-title'}"
                      SetSize="920 630">
    <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="8">
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="SearchEdit"
                      PlaceHolder="{Loc 'nc-property-console-search-placeholder'}"
                      HorizontalExpand="True" />
            <Button Name="SearchButton" Text="{Loc 'nc-property-console-search'}" />
            <Label Text="{Loc 'nc-property-console-balance'}" StyleClasses="LabelKeyText" />
            <Label Name="BalanceLabel" MinWidth="110" />
        </BoxContainer>

        <Label Name="NoticeLabel" Visible="False" Align="Center" FontColorOverride="#E6C15D" />
        <PanelContainer StyleClasses="LowDivider" />

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Vertical" MinWidth="390" MaxWidth="390" SeparationOverride="6">
                <Label Text="{Loc 'nc-property-console-properties'}" StyleClasses="LabelHeading" />
                <ItemList Name="PropertyList" SelectMode="Single" VerticalExpand="True" MinHeight="430" />
                <Label Name="EmptyListLabel"
                       Text="{Loc 'nc-property-console-empty'}"
                       FontColorOverride="DarkGray"
                       Align="Center" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="5">
                    <Button Name="PreviousPageButton" Text="{Loc 'nc-property-console-previous'}" />
                    <Label Name="PageLabel" Align="Center" HorizontalExpand="True" />
                    <Button Name="NextPageButton" Text="{Loc 'nc-property-console-next'}" />
                </BoxContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" />

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
                <Label Name="SelectPrompt"
                       Text="{Loc 'nc-property-console-select'}"
                       FontColorOverride="DarkGray"
                       Align="Center" />
                <BoxContainer Name="DetailsContainer" Orientation="Vertical" SeparationOverride="7" Visible="False">
                    <Label Name="ApartmentNameLabel" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-property-console-building'}" StyleClasses="LabelKeyText" />
                        <Label Name="BuildingLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-property-console-id'}" StyleClasses="LabelKeyText" />
                        <Label Name="PropertyIdLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-property-console-status'}" StyleClasses="LabelKeyText" />
                        <Label Name="StatusLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-property-console-occupancy'}" StyleClasses="LabelKeyText" />
                        <Label Name="OccupancyLabel" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" />
                    <Label Text="{Loc 'nc-property-console-interior-title'}" StyleClasses="LabelSubHeading" />
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'nc-property-console-current-interior'}" StyleClasses="LabelKeyText" />
                        <Label Name="CurrentInteriorLabel" />
                    </BoxContainer>
                    <OptionButton Name="InteriorSelector" />
                    <Label Name="RentPriceLabel" />
                    <Label Name="NextRentDueLabel" Visible="False" />
                    <Button Name="RentButton"
                            Text="{Loc 'nc-property-console-rent-selected'}"
                            Disabled="True" />
                    <controls:ConfirmButton Name="EndLeaseButton"
                                            Text="{Loc 'nc-property-console-end-lease'}"
                                            ConfirmationText="{Loc 'nc-property-console-end-lease-confirm'}"
                                            Visible="False"
                                            Disabled="True" />
                    <Label Name="InteriorStateLabel"
                           Visible="False"
                           Align="Center"
                           FontColorOverride="#E6C15D" />
                    <Button Name="InvokeInteriorButton"
                            Text="{Loc 'nc-property-console-invoke-interior'}"
                            Visible="False"
                            Disabled="True" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
