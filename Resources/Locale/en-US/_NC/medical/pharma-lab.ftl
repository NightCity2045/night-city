# --- Process consumables ------------------------------------------------------------------------------------
reagent-name-nc-pharma-catalyst = reaction catalyst
reagent-desc-nc-pharma-catalyst = Speeds a reaction up and makes it run hotter. The thermoreactor draws it out of a vial, two units for every charge.
reagent-name-nc-pharma-stabilizer = stabilizer
reagent-desc-nc-pharma-stabilizer = Keeps a finished batch from breaking down. A formula with the stabilizer modifier uses five units for every production run.
ent-NCPharmaCatalystVial = catalyst vial
    .desc = A vial of reaction catalyst. Put it in the thermoreactor's catalyst slot; it can be topped up or poured out like any vial.
ent-NCPharmaStabilizerVial = stabilizer vial
    .desc = A vial of stabilizer. Put it in the synthesizer's additive slot; it can be topped up or poured out like any vial.
nc-pharma-station-additive-slot = additive vial
nc-pharma-reactor-catalyst-slot = catalyst vial
nc-pharma-station-notice-missing-additive = This formula needs a vial with at least {$amount} units of {$item} in the additive slot.
nc-pharma-station-additive-line = Uses up {$amount} units of {$item} per run.

# --- Waste -------------------------------------------------------------------------------------------------
reagent-name-nc-pharma-waste = laboratory waste
reagent-desc-nc-pharma-waste = Hazardous waste from a station. It poisons whoever swallows or breathes it, and it is burned in a waste incinerator.
ent-NCPharmaWasteCanister = waste canister
    .desc = A jug for hazardous waste. Put it in a station's waste slot and the station pours its waste into it; a canister with waste in it leaks fumes if it is left lying around. Burn the waste in a powered incinerator.
nc-pharma-waste-slot = waste canister

# --- Samples and filters ----------------------------------------------------------------------------------
reagent-name-nc-lab-sample-fluid = patient sample
reagent-desc-nc-lab-sample-fluid = A sample taken from a patient. What it shows is only known to a laboratory.
