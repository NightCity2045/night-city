module examples.equippedshot;
import meta.drone;
import meta.system;
link camera: drone.Perception = "equipped-drone-camera";
link weapon: drone.WeaponController = "equipped-drone-weapon";
async fn main() -> void {
    match(weapon.snapshot()) {
        ok(state) => { if(!state.equipped || !state.ready || state.loaded < 1) { system.log("Native weapon interlock."); return; } }
        err(error) => { return; }
    }
    match(camera.observe()) {
        ok(contacts) => {
            for(let contact in contacts) {
                if(contact.kind == drone.ContactKind.Mobile) {
                    match(await weapon.fire(contact.reference, "controlled-trigger-1")) {
                        ok(receipt) => {
                            if(receipt.status == system.OperationStatus.Applied) { system.log("Native shot confirmed."); }
                            else { system.log("Inspect the durable shot outcome before retrying."); }
                        }
                        err(error) => { system.log("Native shot rejected."); }
                    }
                    return;
                }
            }
        }
        err(error) => { system.log("No current optical observation."); }
    }
}
