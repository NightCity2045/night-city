module stock.security;
import meta.app;
import meta.system;
import meta.text;
import meta.security;
import meta.doors;
import meta.files;
link camera:security.Camera="owned-camera";
link door:doors.Door="owned-door";
link data:files.FileStore="journal-data";
var report:string="";
var failed:bool=false;
pub struct JournalState {title:string;report:string;status:string;refreshLabel:string;}
pub struct Empty {}
fn label(ru:bool,english:string,russian:string)->string {if(ru){return russian;}return english;}
pub fn view(context:app.AppContext)->JournalState {
    let ru:bool=context.locale=="ru-RU";
    var status:string=label(ru,"Private rolling device log; not an authority receipt.","Личный кольцевой журнал устройств; не квитанция полномочий.");
    if(failed){status=label(ru,"Log storage unavailable","Хранилище журнала недоступно");}
    return new JournalState(title:label(ru,"Security journal","Журнал охраны"),report:report,status:status,refreshLabel:label(ru,"Refresh","Обновить"));
}
pub fn refresh(context:app.AppContext,input:Empty)->result<void>{return ok(());}
async fn append(line:string)->void {
    if(report.length>3000){report="";}
    report=report+line+"\n";
    match(await data.writeTextAtomic("security/log.txt",report)){ok(_)=>{failed=false;}err(error)=>{failed=true;}}
}
async fn main()->void {
    match(await data.readText("security/log.txt")){ok(saved)=>{if(saved.length<=3000){report=saved;}}err(error)=>{}}
}
async watch camera.motionDetected(event) {
    if(system.isFresh(event.stamp,2000)&&event.confidence>=0.5){await append(text.fromInt(event.stamp.sequence)+": Motion / Движение");}
}
async watch door.stateChanged(state) {
    if(system.isFresh(state.stamp,2000)){await append(text.fromInt(state.stamp.sequence)+": Door changed / Дверь изменила состояние");}
}

