module stock.control;
import meta.app;
import meta.system;
import meta.doors;
link door:doors.Door="owned-door";
var observed:bool=false;
var lastSeen:int=0;
var phase:doors.DoorPhase=DoorPhase.Closed;
pub struct ControlState {title:string;status:string;openLabel:string;closeLabel:string;note:string;}
pub struct Empty {}
fn label(ru:bool,english:string,russian:string)->string {if(ru){return russian;}return english;}
pub fn view(context:app.AppContext)->ControlState {
    let ru:bool=context.locale=="ru-RU";
    var status:string=label(ru,"No fresh observation","Нет свежего наблюдения");
    if(observed&&system.nowMs()-lastSeen<=2000){
        status=label(ru,"Door transitioning","Дверь движется");
        if(phase==DoorPhase.Open){status=label(ru,"Open","Открыта");}
        else if(phase==DoorPhase.Closed){status=label(ru,"Closed","Закрыта");}
        else if(phase==DoorPhase.Blocked){status=label(ru,"Blocked","Заблокирована");}
    }
    return new ControlState(title:label(ru,"Owned door control","Управление своей дверью"),status:status,
        openLabel:label(ru,"Request open","Открыть"),closeLabel:label(ru,"Request close","Закрыть"),
        note:label(ru,"Physical access, power, bolts and collision safety remain authoritative.","Доступ, питание, болты и защита от столкновений проверяются оборудованием."));
}
pub async fn open(context:app.AppContext,input:Empty)->result<void> {
    match(await door.setOpen(true)){ok(state)=>{phase=state.phase;observed=true;lastSeen=system.nowMs();return ok(());}err(error)=>{return err(error);}}
}
pub async fn close(context:app.AppContext,input:Empty)->result<void> {
    match(await door.setOpen(false)){ok(state)=>{phase=state.phase;observed=true;lastSeen=system.nowMs();return ok(());}err(error)=>{return err(error);}}
}
watch door.stateChanged(state){if(system.isFresh(state.stamp,2000)){phase=state.phase;observed=true;lastSeen=system.nowMs();}}

