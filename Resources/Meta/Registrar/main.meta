module citinet.registrar;
import meta.system;
import meta.text;
import meta.net;
import meta.files;
import meta.economy;

// The CitiNet name registrar, written in META. A site owner asks for a name that points at a host and a view; a browser
// asks what a name points at. Requests and answers are plain messages:
//   dns.quote     name                     ->  dns.price       ok|name|price|device  /  taken|name  /  invalid|name
//   dns.register  name|device|view|receipt ->  dns.registered  ok|name  /  taken|name  /  invalid|name  /  unpaid|name
//   dns.resolve   name                     ->  dns.answer      ok|name|device|view  /  none|name
//   dns.search   text (empty = all)        ->  dns.found       ok|name,name,...  (up to 20 names that contain the text)
// A new name is paid for first: the buyer pays the registrar's owner through the wallet with the memo citi:name and
// sends the receipt, which the registrar checks and keeps so it can never be used twice. The first to register a name
// owns it; only the same sender may point it somewhere else, and that costs nothing.

link port: MessagePort = "registrar-port";
link data: FileStore = "registrar-data";
link wallet: Wallet = "registrar-wallet";

var used: list<string> = new list<string>();

var names: list<string> = new list<string>();
var devices: list<string> = new list<string>();
var views: list<string> = new list<string>();
var owners: list<string> = new list<string>();

fn field(source: string, wanted: int) -> string {
    var current: string = "";
    var index: int = 0;
    var seen: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == "|") {
                    if (seen == wanted) { return current; }
                    seen = seen + 1;
                    current = "";
                } else {
                    current = current + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
    if (seen == wanted) { return current; }
    return "";
}

fn indexOf(name: string) -> int {
    var index: int = 0;
    while (index < names.length) {
        if (names[index] == name) { return index; }
        index = index + 1;
    }
    return -1;
}

fn nameSymbol(symbol: string) -> bool {
    let alphabet: string = "abcdefghijklmnopqrstuvwxyz0123456789-";
    var index: int = 0;
    while (index < alphabet.length) {
        match (text.slice(alphabet, index, 1)) {
            ok(candidate) => { if (candidate == symbol) { return true; } }
            err(problem) => { }
        }
        index = index + 1;
    }
    return false;
}

fn validName(name: string) -> bool {
    if (name.length < 3 || name.length > 32) { return false; }
    var index: int = 0;
    while (index < name.length) {
        match (text.slice(name, index, 1)) {
            ok(symbol) => { if (!nameSymbol(symbol)) { return false; } }
            err(problem) => { return false; }
        }
        index = index + 1;
    }
    return true;
}

fn validTarget(device: string, view: string) -> bool {
    if (device.length != 6) { return false; }
    if (view.length < 1 || view.length > 32) { return false; }
    return validName(view) || view == "main";
}

fn serialize() -> string {
    var joined: string = "";
    var index: int = 0;
    while (index < names.length) {
        joined = joined + names[index] + "|" + devices[index] + "|" + views[index] + "|" + owners[index] + "\n";
        index = index + 1;
    }
    return joined;
}

fn parse(source: string) -> void {
    var line: string = "";
    var index: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == "\n") {
                    if (line.length > 0 && names.length < 256) {
                        names.push(field(line, 0));
                        devices.push(field(line, 1));
                        views.push(field(line, 2));
                        owners.push(field(line, 3));
                    }
                    line = "";
                } else {
                    line = line + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
}

fn joinUsed() -> string {
    var joined: string = "";
    for (let item in used) {
        joined = joined + item + "\n";
    }
    return joined;
}

fn parseUsed(source: string) -> void {
    var line: string = "";
    var index: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == "\n") {
                    if (line.length > 0 && used.length < 256) { used.push(line); }
                    line = "";
                } else {
                    line = line + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
}

async fn save() -> void {
    match (await data.writeTextAtomic("registry/names.txt", serialize())) {
        ok(done) => { }
        err(problem) => { system.log(problem.message); }
    }
    match (await data.writeTextAtomic("registry/receipts.txt", joinUsed())) {
        ok(done) => { }
        err(problem) => { system.log(problem.message); }
    }
}

async fn main() -> void {
    match (await data.readText("registry/names.txt")) {
        ok(saved) => { parse(saved); }
        err(problem) => { }
    }
    match (await data.readText("registry/receipts.txt")) {
        ok(saved) => { parseUsed(saved); }
        err(problem) => { }
    }
}

async fn reply(to: string, topic: string, payload: string) -> void {
    match (await port.send(to, topic, payload)) {
        ok(receipt) => { }
        err(problem) => { system.log(problem.message); }
    }
}

async fn resolve(sender: string, name: string) -> void {
    let position: int = indexOf(name);
    if (position < 0) {
        await reply(sender, "dns.answer", "none|" + name);
        return;
    }
    await reply(sender, "dns.answer", "ok|" + name + "|" + devices[position] + "|" + views[position]);
}

fn contains(name: string, query: string) -> bool {
    if (query.length == 0) { return true; }
    if (query.length > name.length) { return false; }
    var start: int = 0;
    while (start + query.length <= name.length) {
        match (text.slice(name, start, query.length)) {
            ok(part) => { if (part == query) { return true; } }
            err(problem) => { }
        }
        start = start + 1;
    }
    return false;
}

async fn search(sender: string, query: string) -> void {
    var found: string = "";
    var count: int = 0;
    var index: int = 0;
    while (index < names.length && count < 20) {
        if (contains(names[index], query)) {
            if (count > 0) { found = found + ","; }
            found = found + names[index];
            count = count + 1;
        }
        index = index + 1;
    }
    await reply(sender, "dns.found", "ok|" + found);
}

async fn quote(sender: string, name: string) -> void {
    if (!validName(name)) {
        await reply(sender, "dns.price", "invalid|" + name);
        return;
    }
    if (indexOf(name) >= 0) {
        await reply(sender, "dns.price", "taken|" + name);
        return;
    }
    var me: string = "";
    match (wallet.selfDevice()) {
        ok(code) => { me = code; }
        err(problem) => { }
    }
    await reply(sender, "dns.price", "ok|" + name + "|100|" + me);
}

// A new name costs 100 and the receipt must name it in its memo; each receipt is accepted once.
async fn paidFor(name: string, receipt: string) -> bool {
    if (receipt.length < 1 || indexOfUsed(receipt) >= 0 || used.length >= 256) { return false; }
    match (await wallet.received(receipt)) {
        ok(found) => {
            if (found.amount >= 100 && found.memo == "citi:" + name) {
                used.push(receipt);
                return true;
            }
            return false;
        }
        err(problem) => { return false; }
    }
}

fn indexOfUsed(receipt: string) -> int {
    var index: int = 0;
    while (index < used.length) {
        if (used[index] == receipt) { return index; }
        index = index + 1;
    }
    return -1;
}

async fn register(sender: string, payload: string) -> void {
    let name: string = field(payload, 0);
    let device: string = field(payload, 1);
    let view: string = field(payload, 2);
    let receipt: string = field(payload, 3);
    if (!validName(name) || !validTarget(device, view)) {
        await reply(sender, "dns.registered", "invalid|" + name);
        return;
    }
    let position: int = indexOf(name);
    if (position >= 0 && owners[position] != sender) {
        await reply(sender, "dns.registered", "taken|" + name);
        return;
    }
    if (position >= 0) {
        devices[position] = device;
        views[position] = view;
    } else {
        if (names.length >= 256) {
            await reply(sender, "dns.registered", "invalid|" + name);
            return;
        }
        let paid: bool = await paidFor(name, receipt);
        if (!paid) {
            await reply(sender, "dns.registered", "unpaid|" + name);
            return;
        }
        names.push(name);
        devices.push(device);
        views.push(view);
        owners.push(sender);
    }
    await save();
    await reply(sender, "dns.registered", "ok|" + name);
}

async watch port.messageReceived(message) {
    if (message.topic == "dns.resolve") {
        await resolve(message.replyTo, message.payload);
        return;
    }
    if (message.topic == "dns.search") {
        await search(message.replyTo, message.payload);
        return;
    }
    if (message.topic == "dns.quote") {
        await quote(message.replyTo, message.payload);
        return;
    }
    if (message.topic == "dns.register") {
        await register(message.replyTo, message.payload);
        return;
    }
}
