{
  "version": "1.0",
  "views": {
    "main": {
      "function": "citinet.browser.view",
      "document": "ui/main.mui",
      "stateType": "citinet.browser.BrowserState",
      "fields": {
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "subtitle": {
          "type": "string",
          "maxLength": 256
        },
        "status": {
          "type": "string",
          "maxLength": 256
        },
        "page": {
          "type": "string",
          "maxLength": 256
        },
        "addressLabel": {
          "type": "string",
          "maxLength": 256
        },
        "openLabel": {
          "type": "string",
          "maxLength": 256
        },
        "markLabel": {
          "type": "string",
          "maxLength": 256
        },
        "historyHeading": {
          "type": "string",
          "maxLength": 256
        },
        "marksHeading": {
          "type": "string",
          "maxLength": 256
        },
        "hint": {
          "type": "string",
          "maxLength": 256
        },
        "sitesHeading": {
          "type": "string",
          "maxLength": 256
        },
        "registerHeading": {
          "type": "string",
          "maxLength": 256
        },
        "nameLabel": {
          "type": "string",
          "maxLength": 256
        },
        "deviceLabel": {
          "type": "string",
          "maxLength": 256
        },
        "viewLabel": {
          "type": "string",
          "maxLength": 256
        },
        "registerLabel": {
          "type": "string",
          "maxLength": 256
        },
        "offerText": {
          "type": "string",
          "maxLength": 256
        },
        "confirmLabel": {
          "type": "string",
          "maxLength": 256
        },
        "offerVisible": {
          "type": "boolean"
        },
        "history": {
          "type": "array",
          "maxLength": 512
        },
        "sites": {
          "type": "array",
          "maxLength": 512
        },
        "marks": {
          "type": "array",
          "maxLength": 512
        }
      },
      "actions": [
        "open",
        "mark",
        "register",
        "confirm"
      ]
    }
  },
  "actions": {
    "open": {
      "function": "citinet.browser.open",
      "inputType": "citinet.browser.OpenInput",
      "inputs": {
        "address": {
          "type": "string",
          "maxLength": 192
        }
      },
      "scopes": []
    },
    "register": {
      "function": "citinet.browser.register",
      "inputType": "citinet.browser.RegisterInput",
      "inputs": {
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "device": {
          "type": "string",
          "maxLength": 6
        },
        "view": {
          "type": "string",
          "maxLength": 32
        }
      },
      "scopes": []
    },
    "confirm": {
      "function": "citinet.browser.confirm",
      "inputType": "citinet.browser.MarkInput",
      "inputs": {
        "note": {
          "type": "string",
          "maxLength": 32,
          "required": false
        }
      },
      "scopes": []
    },
    "mark": {
      "function": "citinet.browser.mark",
      "inputType": "citinet.browser.MarkInput",
      "inputs": {
        "note": {
          "type": "string",
          "maxLength": 32,
          "required": false
        }
      },
      "scopes": []
    }
  },
  "resources": [
    "fonts/noto-bold",
    "fonts/mono",
    "images/info"
  ]
}
