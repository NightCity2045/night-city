// The CitiNet browser, written in META. It keeps the pages you visited and marked, and asks the computer to open an
// address in a window of its own: a local site as DEVICECODE/view, a published site by its device code, or a city
// name as citi://name, which the name registrar answers with a device and a view.

link web: Browser = "citinet-browser";
link port: MessagePort = "browser-port";
link data: FileStore = "browser-data";
link wallet: Wallet = "browser-wallet";

var history: list<string> = new list<string>();
var marks: list<string> = new list<string>();
var current: string = "";
var pending: string = "";
var notice: string = "";
var linked: bool = false;
var sites: list<string> = new list<string>();
var offerName: string = "";
var offerDevice: string = "";
var offerView: string = "";
var offerPayee: string = "";
var offerPrice: int = 0;
var offerReady: bool = false;
var programId: string = "";
var programName: string = "";
var programSite: string = "";
var programScopes: string = "";
var programReady: bool = false;

pub struct PageRow {
    address: string;
    label: string;
}

