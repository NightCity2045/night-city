    homeLabel: string;
    backLabel: string;
    startVisible: bool;
    pageVisible: bool;
    linked: bool;
    sitesHeading: string;
    sites: list<PageRow>;
    registerHeading: string;
    nameLabel: string;
    deviceLabel: string;
    viewLabel: string;
    registerLabel: string;
    offerVisible: bool;
    programVisible: bool;
    programText: string;
    installLabel: string;
    declineLabel: string;
    offerText: string;
    confirmLabel: string;
