// The permissions the game listed for the offered program, comma separated, as one readable sentence part.
fn scopeList(ru: bool, source: string) -> string {
    if (source.length < 1) { return tr(ru, "nothing special", "ничего особенного"); }
    var joined: string = "";
    var piece: string = "";
    var index: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == ",") {
                    if (joined.length > 0) { joined = joined + "; "; }
                    joined = joined + scopeName(ru, piece);
                    piece = "";
                } else {
                    piece = piece + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
    if (piece.length > 0) {
        if (joined.length > 0) { joined = joined + "; "; }
        joined = joined + scopeName(ru, piece);
    }
    return joined;
}

fn offerSentence(ru: bool) -> string {
    if (!programReady) { return ""; }
    return tr(ru, "The site ", "Сайт ") + programSite + tr(ru, " offers the program ", " предлагает программу ") + programName +
        tr(ru, ". It asks for: ", ". Требуются права: ") + scopeList(ru, programScopes);
}

fn field(source: string, wanted: int) -> string {
    var part: string = "";
    var index: int = 0;
    var seen: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == "|") {
                    if (seen == wanted) { return part; }
                    seen = seen + 1;
                    part = "";
                } else {
                    part = part + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
    if (seen == wanted) { return part; }
    return "";
}

// A city name is what follows citi:// when it has no slash and is short; longer forms name a device directly.
fn cityName(address: string) -> string {
    if (address.length <= 7 || address.length > 39) { return ""; }
    match (text.slice(address, 0, 7)) {
        ok(prefix) => { if (prefix != "citi://") { return ""; } }
        err(problem) => { return ""; }
    }
    match (text.slice(address, 7, address.length - 7)) {
        ok(name) => {
            var index: int = 0;
            while (index < name.length) {
                match (text.slice(name, index, 1)) {
                    ok(symbol) => { if (symbol == "/") { return ""; } }
                    err(problem) => { return ""; }
                }
                index = index + 1;
            }
            return name;
        }
        err(problem) => { return ""; }
    }
}

fn hasSlash(value: string) -> bool {
    var index: int = 0;
    while (index < value.length) {
        match (text.slice(value, index, 1)) {
            ok(symbol) => { if (symbol == "/") { return true; } }
            err(problem) => { return false; }
        }
        index = index + 1;
    }
    return false;
}

fn splitNames(source: string) -> list<string> {
    var parts: list<string> = new list<string>();
    var part: string = "";
    var index: int = 0;
    while (index < source.length && parts.length < 20) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == ",") {
                    if (part.length > 0) { parts.push(part); }
                    part = "";
                } else {
                    part = part + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
    if (part.length > 0 && parts.length < 20) { parts.push(part); }
    return parts;
}

fn siteRows() -> list<PageRow> {
    var rows: list<PageRow> = new list<PageRow>();
    for (let name in sites) {
        rows.push(new PageRow(address: "citi://" + name, label: name));
    }
    return rows;
}

fn indexOf(items: list<string>, item: string) -> int {
    var index: int = 0;
    while (index < items.length) {
        if (items[index] == item) { return index; }
        index = index + 1;
    }
    return -1;
}

fn join(items: list<string>) -> string {
    var joined: string = "";
    for (let item in items) {
        joined = joined + item + "\n";
    }
    return joined;
}

fn parse(source: string) -> void {
    var line: string = "";
    var index: int = 0;
    while (index < source.length) {
        match (text.slice(source, index, 1)) {
            ok(symbol) => {
                if (symbol == "\n") {
                    if (line.length > 0 && marks.length < 32) { marks.push(line); }
                    line = "";
                } else {
                    line = line + symbol;
                }
            }
            err(problem) => { }
        }
        index = index + 1;
    }
}

fn rowsNewestFirst(items: list<string>) -> list<PageRow> {
    var rows: list<PageRow> = new list<PageRow>();
    var index: int = items.length - 1;
    while (index >= 0) {
        rows.push(new PageRow(address: items[index], label: items[index]));
        index = index - 1;
    }
    return rows;
}

fn remember(address: string) -> void {
    if (history.length > 0 && history[history.length - 1] == address) { return; }
    var kept: list<string> = new list<string>();
    var index: int = 0;
    if (history.length >= 16) { index = 1; }
    while (index < history.length) {
        kept.push(history[index]);
        index = index + 1;
    }
    kept.push(address);
    history = kept;
}

async fn save() -> void {
    match (await data.writeTextAtomic("browser/bookmarks.txt", join(marks))) {
        ok(done) => { }
        err(problem) => { notice = problem.message; }
    }
}

// Asks the registrar for the sites whose names contain the text; the answer is a message that fills the list.
async fn ask(query: string) -> void {
    match (await port.send("citinet-registrar", "dns.search", query)) {
        ok(receipt) => { }
        err(problem) => { }
    }
}

async fn main() -> void {
    match (await data.readText("browser/bookmarks.txt")) {
        ok(saved) => { parse(saved); }
        err(problem) => { }
    }
    await ask("");
}

async fn quote(name: string, device: string, view: string) -> void {
    offerReady = false;
    offerName = name;
    offerDevice = device;
    offerView = view;
    notice = "quoting";
    match (await port.send("citinet-registrar", "dns.quote", name)) {
        ok(receipt) => { }
        err(problem) => { notice = "noroute"; }
    }
}

async fn visit(address: string) -> void {
    // The one bar both searches and opens: an address opens, anything else is looked up among the sites; empty refreshes the list.
    if (address.length < 1) {
        notice = "searching";
        await ask("");
        return;
    }
    if (!hasSlash(address)) {
        notice = "searching";
        await ask(address);
        return;
    }
    let name: string = cityName(address);
    if (name.length > 0) {
        // A city name: ask the registrar; its answer arrives as a message and finishes the job.
        pending = name;
        notice = "resolving";
        match (await port.send("citinet-registrar", "dns.resolve", name)) {
            ok(receipt) => { }
            err(problem) => {
                pending = "";
                notice = "noroute";
            }
        }
        return;
    }
    match (await web.open(address)) {
        ok(done) => {
            current = address;
            notice = "";
            remember(address);
        }
        err(problem) => {
            notice = "unreachable";
        }
    }
}

// A site offers a program. The game itself raises this, with what the program really asks for, so a page cannot
// make an offer look harmless: read the list of permissions before agreeing.
async watch web.offerReceived(offer) {
    programId = offer.id;
    programName = offer.name;
    programSite = offer.site;
    programScopes = offer.scopes;
    programReady = true;
}

async watch port.messageReceived(message) {
    linked = true;
    if (message.topic == "dns.found") {
        sites = splitNames(field(message.payload, 1));
        if (sites.length == 0) { notice = "nothing"; }
        else if (notice == "searching") { notice = ""; }
        return;
    }
    if (message.topic == "dns.price") {
        if (field(message.payload, 1) != offerName) { return; }
        if (field(message.payload, 0) != "ok") {
            notice = field(message.payload, 0);
            return;
        }
        match (text.parseInt(field(message.payload, 2))) {
            ok(price) => {
                offerPrice = price;
                offerPayee = field(message.payload, 3);
                offerReady = true;
                notice = "offer";
            }
            err(problem) => { notice = "invalid"; }
        }
        return;
    }
    if (message.topic == "dns.registered") {
        if (field(message.payload, 1) != offerName) { return; }
        notice = field(message.payload, 0);
        if (notice == "ok") { notice = "registered"; }
        return;
    }
    if (message.topic != "dns.answer") { return; }
    let name: string = field(message.payload, 1);
    if (pending.length < 1 || name != pending) { return; }
    pending = "";
    if (field(message.payload, 0) != "ok") {
        notice = "unknown";
        return;
    }
    let target: string = field(message.payload, 2) + "/" + field(message.payload, 3);
    match (await web.open(target)) {
        ok(done) => {
            current = "citi://" + name;
            notice = "";
            remember(current);
        }
        err(problem) => {
            notice = "unreachable";
        }
    }
}

pub fn view(context: app.AppContext) -> BrowserState {
    let ru: bool = context.locale == "ru-RU";
    var status: string = tr(ru, "Type an address and press Open.", "Введите адрес и нажмите «Открыть».");
    if (current.length > 0) { status = tr(ru, "Last opened: ", "Последняя страница: ") + current; }
    if (notice.length > 0) { status = describe(ru, notice); }
    var markLabel: string = tr(ru, "Bookmark this page", "В закладки");
    if (indexOf(marks, current) >= 0) { markLabel = tr(ru, "Remove bookmark", "Убрать из закладок"); }
    return new BrowserState(
        title: tr(ru, "CitiNet", "СитиНет"),
        subtitle: tr(ru, "The city network browser", "Браузер городской сети"),
        status: status,
        page: current,
        addressLabel: tr(ru, "Address", "Адрес"),
        openLabel: tr(ru, "Open", "Открыть"),
        markLabel: markLabel,
        historyHeading: tr(ru, "Recent pages", "Недавние страницы"),
        marksHeading: tr(ru, "Bookmarks", "Закладки"),
        hint: tr(ru, "Type a name to search the city, or an address: CODE/view, citi://name", "Введите имя для поиска или адрес: КОД/вид, citi://имя"),
        tagline: tr(ru, "The city network", "Сеть города"),
        homeLabel: tr(ru, "Home", "Домой"),
        backLabel: tr(ru, "Back", "Назад"),
        startVisible: current.length < 1,
        pageVisible: current.length > 0,
        linked: linked,
        sitesHeading: tr(ru, "Sites on the network", "Сайты сети"),
        sites: siteRows(),
        registerHeading: tr(ru, "Register a city name", "Зарегистрировать имя"),
        nameLabel: tr(ru, "Name", "Имя"),
        deviceLabel: tr(ru, "Host device code", "Код устройства-хоста"),
        viewLabel: tr(ru, "Site view", "Вид сайта"),
        registerLabel: tr(ru, "Get a price", "Узнать цену"),
        offerVisible: offerReady,
        programVisible: programReady,
        programText: offerSentence(ru),
        installLabel: tr(ru, "Install", "Установить"),
        declineLabel: tr(ru, "Decline", "Отказаться"),
        offerText: tr(ru, "Register ", "Зарегистрировать ") + offerName + tr(ru, " for ", " за ") + text.fromInt(offerPrice),
        confirmLabel: tr(ru, "Pay and register", "Оплатить и зарегистрировать"),
        history: rowsNewestFirst(history),
        marks: rowsNewestFirst(marks));
}

pub async fn open(context: app.AppContext, input: OpenInput) -> result<void> {
    await visit(input.address);
    return ok(());
}

pub async fn mark(context: app.AppContext, input: MarkInput) -> result<void> {
    if (current.length < 1) { return ok(()); }
    let position: int = indexOf(marks, current);
    if (position < 0) {
        if (marks.length < 32) { marks.push(current); }
    } else {
        var kept: list<string> = new list<string>();
        var index: int = 0;
        while (index < marks.length) {
            if (index != position) { kept.push(marks[index]); }
            index = index + 1;
        }
        marks = kept;
    }
    await save();
    return ok(());
}

pub async fn register(context: app.AppContext, input: RegisterInput) -> result<void> {
    await quote(input.name, input.device, input.view);
    return ok(());
}

pub async fn confirm(context: app.AppContext, input: MarkInput) -> result<void> {
    if (!offerReady) { return ok(()); }
    offerReady = false;
    match (await wallet.pay(offerPayee, offerPrice, "citi:" + offerName)) {
        ok(receipt) => {
            notice = "paid";
            match (await port.send("citinet-registrar", "dns.register", offerName + "|" + offerDevice + "|" + offerView + "|" + receipt.id)) {
                ok(sent) => { }
                err(problem) => { notice = "noroute"; }
            }
        }
        err(problem) => { notice = "nofunds"; }
    }
    return ok(());
}

// Only a person pressing the button agrees; the game installs the offered program the ordinary way on this computer.
pub async fn install(context: app.AppContext, input: MarkInput) -> result<void> {
    if (!programReady) { return ok(()); }
    programReady = false;
    notice = "installing";
    match (await web.accept(programId)) {
        ok(done) => { notice = "installed"; }
        err(problem) => { notice = "installfail"; }
    }
    return ok(());
}

pub async fn decline(context: app.AppContext, input: MarkInput) -> result<void> {
    if (!programReady) { return ok(()); }
    programReady = false;
    notice = "declined";
    match (await web.decline(programId)) {
        ok(done) => { }
        err(problem) => { }
    }
    return ok(());
}

// Back to the start page: the page of the last site stays loaded behind it until another one is opened.
pub async fn home(context: app.AppContext, input: MarkInput) -> result<void> {
    current = "";
    notice = "";
    await ask("");
    return ok(());
}

// One step back through the pages that were opened.
pub async fn back(context: app.AppContext, input: MarkInput) -> result<void> {
    if (history.length >= 2) { await visit(history[history.length - 2]); }
    return ok(());
}
