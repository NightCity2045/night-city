    marks: list<PageRow>;
}

pub struct OpenInput {
    address: string;
}

pub struct RegisterInput {
    name: string;
    device: string;
    view: string;
}

pub struct MarkInput {
    note: option<string>;
}

fn tr(ru: bool, english: string, russian: string) -> string {
    if (ru) { return russian; }
    return english;
}

fn describe(ru: bool, code: string) -> string {
    if (code == "empty") { return tr(ru, "Enter an address first.", "Сначала введите адрес."); }
    if (code == "resolving") { return tr(ru, "Asking the registrar for ", "Спрашиваю регистратора про ") + pending + "..."; }
    if (code == "unknown") { return tr(ru, "No such name.", "Нет такого имени."); }
    if (code == "noroute") { return tr(ru, "No route to the registrar.", "Нет связи с регистратором."); }
    if (code == "unreachable") { return tr(ru, "No such page, or no route to it.", "Нет такой страницы или нет связи."); }
    if (code == "searching") { return tr(ru, "Searching the city network...", "Ищу по городской сети..."); }
    if (code == "nothing") { return tr(ru, "No sites found.", "Ничего не найдено."); }
    if (code == "quoting") { return tr(ru, "Asking the registrar for a price...", "Спрашиваю у регистратора цену..."); }
    if (code == "offer") { return tr(ru, "The registrar quotes a price. Confirm to pay and register.", "Регистратор назвал цену. Подтвердите, чтобы оплатить и зарегистрировать."); }
    if (code == "taken") { return tr(ru, "That name is already taken.", "Это имя уже занято."); }
    if (code == "invalid") { return tr(ru, "Names are 3 to 32 letters, digits or dashes, in lower case.", "Имя: от 3 до 32 строчных букв, цифр или дефисов."); }
    if (code == "nofunds") { return tr(ru, "The payment did not go through.", "Платёж не прошёл."); }
    if (code == "paid") { return tr(ru, "Paid. Waiting for the registrar...", "Оплачено. Жду регистратора..."); }
    if (code == "registered") { return tr(ru, "Done: the name is registered.", "Готово: имя зарегистрировано."); }
    if (code == "installing") { return tr(ru, "Installing the program...", "Устанавливаю программу..."); }
    if (code == "installed") { return tr(ru, "The program is installed on this computer.", "Программа установлена на этом компьютере."); }
    if (code == "installfail") { return tr(ru, "The program could not be installed.", "Программу не удалось установить."); }
    if (code == "declined") { return tr(ru, "You turned the program down.", "Вы отказались от программы."); }
    if (code == "unpaid") { return tr(ru, "The registrar did not accept the payment.", "Регистратор не принял оплату."); }
    return code;
}

// What a permission means in plain words, in both languages. A permission the table does not know is shown as it is,
// so a new capability can never be hidden from the person who is asked to agree to it.
