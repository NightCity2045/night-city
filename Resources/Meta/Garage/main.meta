module examples.garage;
import meta.app;
import meta.services;
import meta.vehicle;
import meta.system;
import meta.text;

link orders:services.ServiceOrders="service-orders";
link instruments:vehicle.VehicleDashboard="service-vehicle";
link engine:vehicle.EngineController="service-engine";
var changeRevision:int=0;
struct Selection { session:app.SessionRef; order:string; }
var selections:list<Selection>=new list<Selection>();

pub struct Empty {}
pub struct CreateInput { subject:string; }
pub struct OrderInput { id:string; }
pub struct SelectInput { order:string; }
pub struct InvoiceInput { id:string; amount:int; description:string; }
pub struct OrderRow { id:string; summary:string; status:string; invoice:string; }
pub struct GarageState {
    title:string; message:string; refreshLabel:string; subjectLabel:string; createLabel:string;
    orderLabel:string; payLabel:string; cancelLabel:string; completeLabel:string;
    assignLabel:string; beginLabel:string; readyLabel:string; amountLabel:string; descriptionLabel:string; invoiceLabel:string;
    physicalNote:string; engine:string; vehicle:string; orders:list<OrderRow>;
    selectedId:string; selection:string; hasSelection:bool;
}

fn label(ru:bool,english:string,russian:string)->string { if(ru){return russian;}return english; }
fn statusLabel(status:services.OrderStatus,ru:bool)->string {
    match(status) {
        services.OrderStatus.Submitted => {return label(ru,"Submitted","Создан");}
        services.OrderStatus.Assigned => {return label(ru,"Assigned","Назначен");}
        services.OrderStatus.InProgress => {return label(ru,"Work in progress","В работе");}
        services.OrderStatus.AwaitingPayment => {return label(ru,"Awaiting payment","Ожидает оплаты");}
        services.OrderStatus.Paid => {return label(ru,"Paid","Оплачен");}
        services.OrderStatus.Ready => {return label(ru,"Ready for collection","Готов к выдаче");}
        services.OrderStatus.Completed => {return label(ru,"Completed","Завершён");}
        services.OrderStatus.Cancelled => {return label(ru,"Cancelled","Отменён");}
    }
}
fn shortSubject(subject:string)->string {
    if(subject.length<=80){return subject;}
    match(text.slice(subject,0,80)){ok(value)=>{return value+"…";}err(error)=>{return subject;}}
}
fn orderReference(id:string)->string {
    match(text.slice(id,0,8)){ok(value)=>{return "ORD-"+value;}err(error)=>{return "ORD-?";}}
}
fn selectedFor(context:app.AppContext)->string {
    for(let cached in selections) {if(app.sameSession(cached.session,context.session)){return cached.order;}}
    return "";
}
fn build(context:app.AppContext,staff:bool)->GarageState {
    let ru:bool=context.locale=="ru-RU";
    let rows=new list<OrderRow>();
    let wanted=selectedFor(context);
    var selectedId="";
    var selection=label(ru,"Select an order in the table.","Выберите заказ в таблице.");
    var message=label(ru,"Refresh to load your permitted orders.","Обновите список доступных вам заказов.");
    match(orders.cachedList(context.user,context.session)) {
        ok(records)=>{
            message=label(ru,"Orders available to your current account.","Заказы, доступные вашей текущей учётной записи.");
            for(let order in records) {
                var invoiceText=label(ru,"No invoice","Без счёта");
                if(order.invoiceId!="") {
                    invoiceText=label(ru,"Invoice: ","Счёт: ")+text.fromInt(order.amount);
                    if(order.paid){invoiceText=invoiceText+label(ru," · paid"," · оплачен");}
                }
                let summary=orderReference(order.id)+" · "+shortSubject(order.subject);
                rows.push(new OrderRow(id:order.id,summary:summary,status:statusLabel(order.status,ru),invoice:invoiceText));
                if(order.id==wanted) {selectedId=order.id;selection=summary;}
            }
        }
        err(error)=>{}
    }
    var engineText="";var vehicleText="";
    if(staff) {
        engineText=label(ru,"No current permitted engine sample.","Нет актуальных разрешённых показаний двигателя.");
        vehicleText=label(ru,"No current permitted vehicle sample.","Нет актуальных разрешённых показаний автомобиля.");
        match(engine.snapshot()) {
            ok(sample)=>{if(system.isFresh(sample.stamp,1000)){
                engineText=label(ru,"Engine: ","Двигатель: ")+text.fromInt(sample.rpm)+" rpm · "+text.fromFloat(sample.temperatureC)+" °C · "+text.fromFloat(sample.oilPressureKPa)+" kPa";
            }}
            err(error)=>{}
        }
        match(instruments.snapshot()) {
            ok(sample)=>{if(system.isFresh(sample.stamp,1000)){
                vehicleText=label(ru,"Vehicle: ","Автомобиль: ")+text.fromFloat(sample.speedMps*3.6)+" km/h · "+text.fromFloat(sample.fuelLitres)+" L";
            }}
            err(error)=>{}
        }
    }
    return new GarageState(title:label(ru,"Garage service desk","Заказы автомастерской"),message:message,
        refreshLabel:label(ru,"Refresh orders","Обновить заказы"),subjectLabel:label(ru,"Describe the requested work","Опишите требуемые работы"),
        createLabel:label(ru,"Create order","Создать заказ"),orderLabel:label(ru,"Selected order","Выбранный заказ"),
        payLabel:label(ru,"Review payment confirmation","Открыть подтверждение оплаты"),cancelLabel:label(ru,"Cancel order","Отменить заказ"),
        completeLabel:label(ru,"Confirm collection","Подтвердить получение"),assignLabel:label(ru,"Take this order","Взять заказ себе"),
        beginLabel:label(ru,"Begin work","Начать работу"),readyLabel:label(ru,"Record physically completed work","Отметить выполненные физические работы"),
        amountLabel:label(ru,"Invoice amount","Сумма счёта"),descriptionLabel:label(ru,"Invoice description","Описание счёта"),
        invoiceLabel:label(ru,"Issue invoice","Выставить счёт"),
        physicalNote:label(ru,"Repair uses the native workshop, actual tools and parts. An order status does not repair a vehicle.",
            "Ремонт выполняется в штатной мастерской настоящими инструментами и деталями. Статус заказа не ремонтирует автомобиль."),
        engine:engineText,vehicle:vehicleText,orders:rows,selectedId:selectedId,selection:selection,hasSelection:selectedId!="");
}
pub fn customerView(context:app.AppContext)->GarageState {return build(context,false);}
pub fn staffView(context:app.AppContext)->GarageState {return build(context,true);}

pub fn selectOrder(context:app.AppContext,input:SelectInput)->result<void> {
    match(orders.cachedList(context.user,context.session)) {
        ok(records)=>{
            var permitted=false;
            for(let order in records) {if(order.id==input.order){permitted=true;}}
            if(!permitted){return err(system.error(system.ErrorCode.AccessDenied,""));}
            let retained=new list<Selection>();
            for(let cached in selections) {
                if(app.sameSession(cached.session,cached.session)&&!app.sameSession(cached.session,context.session)){retained.push(cached);}
            }
            if(retained.length>=64){return err(system.error(system.ErrorCode.QuotaExceeded,""));}
            retained.push(new Selection(session:context.session,order:input.order));
            selections=retained;
            return ok(());
        }
        err(error)=>{return err(error);}
    }
}

pub async fn refresh(context:app.AppContext,input:Empty)->result<void> {
    match(await orders.listOrders(context.user,context.session)){ok(records)=>{return ok(());}err(error)=>{return err(error);}}
}
async fn refreshAfterSuccess(context:app.AppContext)->result<void> {
    // The mutation already succeeded. A failed refresh must not invite replay of that mutation.
    match(await orders.listOrders(context.user,context.session)){ok(records)=>{return ok(());}err(error)=>{return ok(());}}
}
pub async fn create(context:app.AppContext,input:CreateInput)->result<void> {
    match(await orders.create(context.user,context.session,input.subject,"create-order")){ok(order)=>{return await refreshAfterSuccess(context);}err(error)=>{return err(error);}}
}
pub async fn take(context:app.AppContext,input:OrderInput)->result<void> {
    match(await orders.get(context.user,context.session,input.id)){
        ok(order)=>{match(await orders.assign(context.user,context.session,order.id,"self",order.revision,"take-order")){
            ok(updated)=>{return await refreshAfterSuccess(context);}err(error)=>{return err(error);}}}
        err(error)=>{return err(error);}
    }
}
async fn transition(context:app.AppContext,input:OrderInput,action:services.OrderAction,key:string)->result<void> {
    match(await orders.get(context.user,context.session,input.id)){
        ok(order)=>{match(await orders.transition(context.user,context.session,order.id,action,order.revision,key)){
            ok(updated)=>{return await refreshAfterSuccess(context);}err(error)=>{return err(error);}}}
        err(error)=>{return err(error);}
    }
}
pub async fn begin(context:app.AppContext,input:OrderInput)->result<void> {return await transition(context,input,services.OrderAction.Begin,"begin-work");}
pub async fn ready(context:app.AppContext,input:OrderInput)->result<void> {return await transition(context,input,services.OrderAction.Ready,"ready-order");}
pub async fn complete(context:app.AppContext,input:OrderInput)->result<void> {return await transition(context,input,services.OrderAction.Complete,"collect-order");}
pub async fn cancel(context:app.AppContext,input:OrderInput)->result<void> {return await transition(context,input,services.OrderAction.Cancel,"cancel-order");}
pub async fn invoice(context:app.AppContext,input:InvoiceInput)->result<void> {
    match(await orders.get(context.user,context.session,input.id)){
        ok(order)=>{match(await orders.invoice(context.user,context.session,order.id,input.amount,input.description,order.revision,"quote-order")){
            ok(updated)=>{return await refreshAfterSuccess(context);}err(error)=>{return err(error);}}}
        err(error)=>{return err(error);}
    }
}
pub async fn requestPayment(context:app.AppContext,input:OrderInput)->result<void> {
    match(await orders.requestPayment(context.user,context.session,input.id)){ok(request)=>{return ok(());}err(error)=>{return err(error);}}
}
watch orders.orderChanged(change){changeRevision=change.revision;}
