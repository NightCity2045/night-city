module examples.laboratory;
import meta.lab;
import meta.system;
link grinder: lab.Grinder = "grinder";
link packager: lab.ChemMaster = "packager";

watch grinder.operationChanged(receipt) {
    if(receipt.status == system.OperationStatus.Applied) { system.log("Grinding completed."); }
    if(receipt.status == system.OperationStatus.OutcomeUnknown) { system.log("Inspect the laboratory receipt before retrying."); }
}

async fn main() -> void {
    match(await grinder.start(lab.GrinderProgram.Grind, "demo-grind-1")) {
        ok(receipt) => { system.log("Grinding admitted."); }
        err(error) => { system.log("Grinding rejected."); }
    }
    // The packager must already have its own real solution and an output container.
    // This example does not transport the grinder's beaker between machines.
    match(await packager.pills(3, 5, "Laboratory batch", "demo-package-1")) {
        ok(receipt) => {
            if(receipt.status == system.OperationStatus.Applied) { system.log("Packaging completed."); }
        }
        err(error) => { system.log("Packaging rejected."); }
    }
}
