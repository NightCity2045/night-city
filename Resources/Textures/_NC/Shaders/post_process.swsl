light_mode unshaded;
uniform sampler2D SCREEN_TEXTURE;
uniform sampler2D BLOOM_TEXTURE;
uniform sampler2D BLOOM_WIDE_TEXTURE;
uniform sampler2D LUT_TEXTURE;

uniform bool bloomEnabled;
uniform highp float bloomIntensity;
uniform highp float bloomTightWeight;
uniform highp float bloomWideWeight;

uniform bool gradeEnabled;
uniform highp float gradeStrength;

uniform bool vignetteEnabled;
uniform highp float vignetteRadius;
uniform highp float vignetteSoftness;
uniform highp vec4 vignetteColor;

uniform bool grainEnabled;
uniform highp float grainStrength;

const highp float LUT_SIZE = 32.0;

// ACES Filmic Tonemapping
highp vec3 ACESFilm(highp vec3 x) {
    highp float a = 2.51;
    highp float b = 0.03;
    highp float c = 2.43;
    highp float d = 0.59;
    highp float e = 0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}

// Looks a linear colour up in a 32x32x32 table laid out as a 1024x32 strip:
// red across each slice, green down the rows, blue picks the slice.
highp vec3 applyLut(highp vec3 col) {
    highp vec3 cell = clamp(zToSrgb(vec4(col, 1.0)).rgb, 0.0, 1.0) * (LUT_SIZE - 1.0);
    highp float slice = floor(cell.b);
    highp float nextSlice = min(slice + 1.0, LUT_SIZE - 1.0);
    // Texture v runs from the bottom row up, while the strip keeps green 0 in its top row.
    highp float y = 1.0 - (cell.g + 0.5) / LUT_SIZE;
    highp vec2 uv0 = vec2((slice * LUT_SIZE + cell.r + 0.5) / (LUT_SIZE * LUT_SIZE), y);
    highp vec2 uv1 = vec2((nextSlice * LUT_SIZE + cell.r + 0.5) / (LUT_SIZE * LUT_SIZE), y);
    // The table is an sRGB texture, so samples come back linear.
    return mix(texture(LUT_TEXTURE, uv0).rgb, texture(LUT_TEXTURE, uv1).rgb, cell.b - slice);
}

void fragment() {
    highp vec2 screenUV = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp vec4 scene = texture(SCREEN_TEXTURE, screenUV);
    highp vec3 result = scene.rgb;

    // 1. Bloom: a tight halo hugs the source, a wide one spills colour into the surrounding dark.
    if (bloomEnabled) {
        highp vec3 tight = texture(BLOOM_TEXTURE, screenUV).rgb;
        highp vec3 wide = texture(BLOOM_WIDE_TEXTURE, screenUV).rgb;
        result += (tight * bloomTightWeight + wide * bloomWideWeight) * bloomIntensity;
    }

    // 2. Tonemapping (Filmic Look)
    result = ACESFilm(result * 1.1); // Slight exposure boost before tonemapping

    // 3. Colour grade from the lookup table.
    if (gradeEnabled) {
        result = mix(result, applyLut(result), gradeStrength);
    }

    // 4. Vignette
    if (vignetteEnabled) {
        highp float dist = distance(screenUV, vec2(0.5));
        highp float vignette = smoothstep(vignetteRadius, vignetteRadius - vignetteSoftness, dist);
        result = mix(vignetteColor.rgb, result, vignette);
    }

    // 5. Film Grain
    if (grainEnabled) {
        highp float x = (screenUV.x + 4.0) * (screenUV.y + 4.0) * (TIME * 10.0);
        highp float grain = (mod((mod(x, 13.0) + 1.0) * (mod(x, 123.0) + 1.0), 0.01) - 0.005) * grainStrength;
        result *= (1.0 - grain);
    }

    COLOR = vec4(result, scene.a);
}
