{
  "formatVersion": "1.0",
  "id": "c1000000-0000-4000-8000-0000000000c1",
  "name": "WeaponBench",
  "kind": "system",
  "side": "server",
  "metadata": {
    "author": "",
    "description": "Bench lists parts, shows whether a part fits the pistol, installs a direct fit, and returns that part to storage. The client only sends the action.",
    "version": "1.0.0",
    "createdAt": "2026-09-25T20:47:39.371523+00:00",
    "modifiedAt": "2026-09-25T20:47:39.3715232+00:00",
