<Project>
  <!--
  Content specific properties
  Import *before* Robust.Properties.targets
  -->

  <PropertyGroup>
    <LangVersion Condition="'$(LangVersion)' == ''">14</LangVersion>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <!-- NC: explicit opt-in trusted local diagnostics; ordinary content builds keep the client sandbox. -->
    <DefineConstants Condition="'$(EnableNCDiagnostics)' == 'true'">$(DefineConstants);NC_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <!-- NC: isolate trusted diagnostic output from ordinary builds and their incremental compiler inputs. -->
  <PropertyGroup Condition="'$(EnableNCDiagnostics)' == 'true'">
    <OutputPath>$(MSBuildThisFileDirectory)../bin/NCDiagnostics/$(MSBuildProjectName)/</OutputPath>
    <IntermediateOutputPath>obj/NCDiagnostics/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS0618,CS0672,CS0612,CS1062,CS1064,NU1900,NU1901,NU1902,NU1903,NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
