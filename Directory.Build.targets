<Project>
  <PropertyGroup>
    <!-- NC: Keep moderate/high NuGet audit findings visible without blocking restore in submodules. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1902;NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
