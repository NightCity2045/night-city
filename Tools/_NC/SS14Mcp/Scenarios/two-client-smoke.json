{
  "version": 1,
  "id": "two-client-native-input",
  "maximumSeconds": 600,
  "environment": {
    "start": true,
    "clients": 2,
    "graphics": false
  },
  "steps": [
    {
      "id": "session",
      "command": "session_get"
    },
    {
      "id": "fixture",
      "command": "fixture_create",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        }
      }
    },
    {
      "id": "actor",
      "command": "fixture_spawn",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "fixtureId": {
          "$ref": "/steps/fixture/data/fixtureId"
        },
        "prototype": "MobHuman",
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "item",
      "command": "fixture_spawn",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "fixtureId": {
          "$ref": "/steps/fixture/data/fixtureId"
        },
        "prototype": "Crowbar",
        "x": 0.5,
        "y": 0
      }
    },
    {
      "id": "pickup",
      "command": "action_execute",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "actor": {
          "$ref": "/steps/actor/data/netEntity"
        },
        "target": {
          "$ref": "/steps/item/data/netEntity"
        },
        "action": "pickup"
      }
    },
    {
      "id": "pickup-handled",
      "assert": {
        "actual": {
          "$ref": "/steps/pickup/data/handled"
        },
        "equals": true
      }
    },
    {
      "id": "held-item",
      "command": "entity_inspect",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "netEntity": {
          "$ref": "/steps/item/data/netEntity"
        },
        "components": [
          "Transform"
        ]
      }
    },
    {
      "id": "item-contained",
      "assert": {
        "actual": {
          "$ref": "/steps/held-item/data/transform/parent"
        },
        "equals": {
          "$ref": "/steps/actor/data/netEntity"
        }
      }
    },
    {
      "id": "drop",
      "command": "action_execute",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "actor": {
          "$ref": "/steps/actor/data/netEntity"
        },
        "action": "drop"
      }
    },
    {
      "id": "dropped-item",
      "command": "entity_inspect",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "netEntity": {
          "$ref": "/steps/item/data/netEntity"
        },
        "components": [
          "Transform"
        ]
      }
    },
    {
      "id": "item-on-grid",
      "assert": {
        "actual": {
          "$ref": "/steps/dropped-item/data/transform/parent"
        },
        "equals": {
          "$ref": "/steps/fixture/data/grid"
        }
      }
    },
    {
      "id": "snapshot",
      "command": "entity_snapshot",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "netEntity": {
          "$ref": "/steps/actor/data/netEntity"
        },
        "components": [
          "Hands"
        ]
      }
    },
    {
      "id": "metrics",
      "command": "metrics_capture"
    },
    {
      "id": "client1",
      "command": "session_get",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client1"
        }
      }
    },
    {
      "id": "attach1",
      "command": "fixture_attach",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "fixtureId": {
          "$ref": "/steps/fixture/data/fixtureId"
        },
        "actor": {
          "$ref": "/steps/actor/data/netEntity"
        },
        "userId": {
          "$ref": "/steps/client1/data/userId"
        }
      }
    },
    {
      "id": "attached1",
      "command": "condition_wait",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client1"
        },
        "command": "client_inspect",
        "arguments": {},
        "path": "/data/localEntity",
        "equals": {
          "$ref": "/steps/actor/data/netEntity"
        },
        "timeoutSeconds": 30
      }
    },
    {
      "id": "input1",
      "command": "client_input",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client1"
        },
        "serverInstanceId": {
          "$ref": "/steps/client1/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/client1/worldGeneration"
        },
        "function": "move_right",
        "durationMilliseconds": 100
      }
    },
    {
      "id": "ui1",
      "command": "ui_inspect",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client1"
        }
      }
    },
    {
      "id": "actor2",
      "command": "fixture_spawn",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "fixtureId": {
          "$ref": "/steps/fixture/data/fixtureId"
        },
        "prototype": "MobHuman",
        "x": 2,
        "y": 0
      }
    },
    {
      "id": "client2",
      "command": "session_get",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client2"
        }
      }
    },
    {
      "id": "attach2",
      "command": "fixture_attach",
      "arguments": {
        "serverInstanceId": {
          "$ref": "/steps/session/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/session/worldGeneration"
        },
        "fixtureId": {
          "$ref": "/steps/fixture/data/fixtureId"
        },
        "actor": {
          "$ref": "/steps/actor2/data/netEntity"
        },
        "userId": {
          "$ref": "/steps/client2/data/userId"
        }
      }
    },
    {
      "id": "attached2",
      "command": "condition_wait",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client2"
        },
        "command": "client_inspect",
        "arguments": {},
        "path": "/data/localEntity",
        "equals": {
          "$ref": "/steps/actor2/data/netEntity"
        },
        "timeoutSeconds": 30
      }
    },
    {
      "id": "input2",
      "command": "client_input",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client2"
        },
        "serverInstanceId": {
          "$ref": "/steps/client2/serverInstanceId"
        },
        "worldGeneration": {
          "$ref": "/steps/client2/worldGeneration"
        },
        "function": "move_right",
        "durationMilliseconds": 100
      }
    },
    {
      "id": "ui2",
      "command": "ui_inspect",
      "arguments": {
        "targetId": {
          "$ref": "/targets/client2"
        }
      }
    }
  ]
}
