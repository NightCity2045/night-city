<Page id="training" title="{bind title}">
  <Column id="layout" gap="8" margin="12">
    <Header id="title" text="{bind title}"/>
    <Text id="hint" text="{bind hint}"/>
    <Text id="status" text="{bind status}"/>
    <Text id="reading" text="{bind reading}" visible="{bind fresh}"/>
    <Form id="settings" action="configure">
      <Column id="limits" gap="6">
        <Text id="highLabel" text="{bind highLabel}"/>
        <NumberInput id="high" field="high" value="{bind high}" min="1" max="80" step="1"/>
        <Text id="lowLabel" text="{bind lowLabel}"/>
        <NumberInput id="low" field="low" value="{bind low}" min="1" max="80" step="1"/>
        <Button id="apply" action="configure" text="{bind applyLabel}"/>
      </Column>
    </Form>
  </Column>
</Page>

