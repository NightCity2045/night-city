<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Server\</OutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <NoWarn>1998</NoWarn>
    <WarningsAsErrors>RA0032;nullable</WarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <ProjectReference Include="../Content.Meta/Content.Meta.csproj" /> <!-- NC: pure META runtime. -->
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
    <PackageReference Include="NetCord" />
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Serilog" Condition="'$(EnableNCDiagnostics)' == 'true'" /> <!-- NC: bounded diagnostic log capture. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Content.Packaging\Content.Packaging.csproj" />
    <ProjectReference Include="..\Content.Server.Database\Content.Server.Database.csproj" />
    <ProjectReference Include="..\Tools\_NC\Meta\CompilerWorker\CompilerWorker.csproj" ReferenceOutputAssembly="false" /> <!-- NC -->
    <ProjectReference Include="..\Content.Shared.Database\Content.Shared.Database.csproj" />
    <ProjectReference Include="..\Content.Shared\Content.Shared.csproj" />
    <Content Include="server_config.toml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\Robust.EntitySystemSubscriptionsGenerator.targets" />

  <Import Project="..\RobustToolbox\Imports\Lidgren.props" />
  <Import Project="..\RobustToolbox\Imports\Server.props" />
  <Import Project="..\RobustToolbox\Imports\Shared.props" />
  <Import Project="..\RobustToolbox\Imports\Packaging.props" />
  <!-- NC-Edit-Start: the isolated compiler is part of the distributable server. -->
  <Target Name="CopyNCMetaCompilerWorker" AfterTargets="Build">
    <PropertyGroup>
      <NCMetaWorkerDirectory>$(MSBuildProjectDirectory)/../Tools/_NC/Meta/CompilerWorker/bin/$(Configuration)/net10.0</NCMetaWorkerDirectory>
      <NCMetaWorkerDirectory Condition="'$(EnableNCDiagnostics)' == 'true'">$(NCDiagnosticsOutputRoot)/CompilerWorker/net10.0</NCMetaWorkerDirectory>
      <NCMetaWorkerOutputDirectory>$([MSBuild]::NormalizeDirectory('$(TargetDir)', '..', 'MetaCompilerWorker'))</NCMetaWorkerOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <NCMetaWorkerFile Include="$(NCMetaWorkerDirectory)/Meta.CompilerWorker.dll" />
      <NCMetaWorkerFile Include="$(NCMetaWorkerDirectory)/Meta.CompilerWorker.deps.json" />
      <NCMetaWorkerFile Include="$(NCMetaWorkerDirectory)/Meta.CompilerWorker.runtimeconfig.json" />
      <NCMetaWorkerFile Include="$(NCMetaWorkerDirectory)/Content.Meta.dll" />
    </ItemGroup>
    <!-- The game loader recursively scans TargetDir. Only the sibling is a worker bundle. -->
    <Delete Files="$(TargetDir)MetaCompilerWorker/Meta.CompilerWorker.dll;$(TargetDir)MetaCompilerWorker/Meta.CompilerWorker.deps.json;$(TargetDir)MetaCompilerWorker/Meta.CompilerWorker.runtimeconfig.json;$(TargetDir)MetaCompilerWorker/Content.Meta.dll;$(TargetDir)Meta.CompilerWorker.dll;$(TargetDir)Meta.CompilerWorker.deps.json;$(TargetDir)Meta.CompilerWorker.runtimeconfig.json" />
    <Copy SourceFiles="@(NCMetaWorkerFile)" DestinationFolder="$(NCMetaWorkerOutputDirectory)" SkipUnchangedFiles="true" />
  </Target>
  <!-- PublishDir is also populated during Build; publishing the sibling bundle then puts it back under TargetDir. -->
  <Target Name="PublishNCMetaCompilerWorker" AfterTargets="Publish" DependsOnTargets="CopyNCMetaCompilerWorker">
    <PropertyGroup>
      <NCMetaWorkerPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', '..', 'MetaCompilerWorker'))</NCMetaWorkerPublishDirectory>
    </PropertyGroup>
    <Copy SourceFiles="@(NCMetaWorkerFile)" DestinationFolder="$(NCMetaWorkerPublishDirectory)" SkipUnchangedFiles="true" />
  </Target>
  <!-- NC-Edit-End -->
</Project>
